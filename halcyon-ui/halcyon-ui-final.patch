diff --git a/shaders/halcyon_lens.frag b/shaders/halcyon_lens.frag
new file mode 100644
index 0000000..311275a
--- /dev/null
+++ b/shaders/halcyon_lens.frag
@@ -0,0 +1,101 @@
+#version 460 core
+
+#include <flutter/runtime_effect.glsl>
+
+// ============================================================================
+// Halcyon Lens.kt 的 ROUNDED_RECT_REFRACTION_SHADER —— 逐字移植（无色散变体）。
+//
+// 源文件：ui-port/halcyon/.../ui/components/liquid/Lens.kt:125-159
+//         （其自身 adapted from Kyant0/AndroidLiquidGlass, Apache-2.0）
+//
+// 只做「语言/API 机械替换」，其余一个字符都不改：
+//   1) `uniform shader content;`      -> `uniform sampler2D content;`
+//   2) `content.eval(coord)`          -> `evalContent(coord)`（内部 texture 采样）
+//   3) `half4 main(float2)->half4`    -> `void main()` + `out vec4 fragColor`
+//   4) 增加引擎注入的纹理尺寸 u_texSize（Flutter 只能归一化采样，SkSL 可按像素取）
+// uniform 名保持原版：size / offset / cornerRadii / refractionHeight /
+// refractionAmount / depthEffect —— 改名的移植无法与源码 diff 对照。
+//
+// 【Flutter 管线契约】第一个 float uniform 必须是 vec2（引擎注入输入纹理尺寸，
+// 槽 0-1，Dart 侧不得写）；sampler 声明在所有 float uniform 之后。
+// ============================================================================
+uniform vec2 u_texSize;           // 槽 0-1（引擎注入，勿写）
+
+uniform vec2 size;                // 2-3：形状尺寸（物理 px，不含 padding）
+uniform vec2 offset;              // 4-5：-padding（把纹理坐标平移回形状原点）
+uniform vec4 cornerRadii;         // 6-9：四角半径 TL/TR/BR/BL（物理 px）
+uniform float refractionHeight;   // 10：折射带高度
+uniform float refractionAmount;   // 11：折射位移（Dart 侧传负值 = 向内）
+uniform float depthEffect;        // 12：0/1
+
+uniform sampler2D content;        // 槽 0：引擎绑定为滤镜输入
+
+out vec4 fragColor;
+
+vec4 evalContent(vec2 coord) {
+  vec2 uv = coord / u_texSize;
+#ifdef IMPELLER_TARGET_OPENGLES
+  uv.y = 1.0 - uv.y;
+#endif
+  return texture(content, uv);
+}
+
+// ---- 以下 4 个函数与 Lens.kt 的 ROUNDED_RECT_SDF 字符串逐行一致 ----
+// Pixel centers can land exactly on the inner tangent rectangle (especially at
+// fractional/odd-dp radii). GLSL normalize(0) is undefined and draws a rectangular
+// seam on some GPUs. Keep every gradient finite, including the lens center.
+vec2 safeNormalize(vec2 value) {
+  return value / max(length(value), 0.0001);
+}
+
+float radiusAt(vec2 coord, vec4 radii) {
+  if (coord.x >= 0.0) {
+    if (coord.y <= 0.0) return radii.y;
+    else return radii.z;
+  } else {
+    if (coord.y <= 0.0) return radii.x;
+    else return radii.w;
+  }
+}
+
+float sdRoundedRect(vec2 coord, vec2 halfSize, float radius) {
+  vec2 cornerCoord = abs(coord) - (halfSize - vec2(radius));
+  float outside = length(max(cornerCoord, 0.0)) - radius;
+  float inside = min(max(cornerCoord.x, cornerCoord.y), 0.0);
+  return outside + inside;
+}
+
+vec2 gradSdRoundedRect(vec2 coord, vec2 halfSize, float radius) {
+  vec2 cornerCoord = abs(coord) - (halfSize - vec2(radius));
+  if (cornerCoord.x > 0.0 || cornerCoord.y > 0.0) {
+    return sign(coord) * safeNormalize(max(cornerCoord, 0.0));
+  } else {
+    float gradX = step(cornerCoord.y, cornerCoord.x);
+    return sign(coord) * vec2(gradX, 1.0 - gradX);
+  }
+}
+
+float circleMap(float x) {
+  return 1.0 - sqrt(1.0 - x * x);
+}
+
+void main() {
+  vec2 coord = FlutterFragCoord().xy;
+  vec2 halfSize = size * 0.5;
+  vec2 centeredCoord = (coord + offset) - halfSize;
+  float radius = radiusAt(centeredCoord, cornerRadii);
+
+  float sd = sdRoundedRect(centeredCoord, halfSize, radius);
+  if (-sd >= refractionHeight) {
+    fragColor = evalContent(coord);
+    return;
+  }
+  sd = min(sd, 0.0);
+
+  float d = circleMap(1.0 - -sd / refractionHeight) * refractionAmount;
+  float gradRadius = min(radius * 1.5, min(halfSize.x, halfSize.y));
+  vec2 grad = safeNormalize(gradSdRoundedRect(centeredCoord, halfSize, gradRadius) + depthEffect * safeNormalize(centeredCoord));
+
+  vec2 refractedCoord = coord + d * grad;
+  fragColor = evalContent(refractedCoord);
+}
diff --git a/shaders/halcyon_lens_dispersion.frag b/shaders/halcyon_lens_dispersion.frag
new file mode 100644
index 0000000..37b2312
--- /dev/null
+++ b/shaders/halcyon_lens_dispersion.frag
@@ -0,0 +1,132 @@
+#version 460 core
+
+#include <flutter/runtime_effect.glsl>
+
+// ============================================================================
+// Halcyon Lens.kt 的 ROUNDED_RECT_REFRACTION_WITH_DISPERSION_SHADER —— 逐字移植。
+//
+// 源文件：ui-port/halcyon/.../ui/components/liquid/Lens.kt:161-233
+//         （其自身 adapted from Kyant0/AndroidLiquidGlass, Apache-2.0）
+//
+// 机械替换同 halcyon_lens.frag（换 API，不换算法）。7 通道色散的
+// 采样顺序、偏移量（0 / ±1/3 / ±2/3 / 1）与权重（r,g,b 分别 /3.5、/3.0，
+// a /7.0）全部保持原样 —— RGB 三通道错位是另一回事，别混。
+//
+// 原版按 chromaticAberration > 0 选着色器（Lens.kt:38-45），这里分成两个 .frag
+// 文件，Dart 侧按同一判据选，保持一处开关一个语义。
+// ============================================================================
+uniform vec2 u_texSize;           // 槽 0-1（引擎注入，勿写）
+
+uniform vec2 size;                // 2-3
+uniform vec2 offset;              // 4-5
+uniform vec4 cornerRadii;         // 6-9
+uniform float refractionHeight;   // 10
+uniform float refractionAmount;   // 11
+uniform float depthEffect;        // 12
+uniform float chromaticAberration; // 13
+
+uniform sampler2D content;        // 槽 0
+
+out vec4 fragColor;
+
+vec4 evalContent(vec2 coord) {
+  vec2 uv = coord / u_texSize;
+#ifdef IMPELLER_TARGET_OPENGLES
+  uv.y = 1.0 - uv.y;
+#endif
+  return texture(content, uv);
+}
+
+// ---- 与 Lens.kt 的 ROUNDED_RECT_SDF 字符串逐行一致 ----
+vec2 safeNormalize(vec2 value) {
+  return value / max(length(value), 0.0001);
+}
+
+float radiusAt(vec2 coord, vec4 radii) {
+  if (coord.x >= 0.0) {
+    if (coord.y <= 0.0) return radii.y;
+    else return radii.z;
+  } else {
+    if (coord.y <= 0.0) return radii.x;
+    else return radii.w;
+  }
+}
+
+float sdRoundedRect(vec2 coord, vec2 halfSize, float radius) {
+  vec2 cornerCoord = abs(coord) - (halfSize - vec2(radius));
+  float outside = length(max(cornerCoord, 0.0)) - radius;
+  float inside = min(max(cornerCoord.x, cornerCoord.y), 0.0);
+  return outside + inside;
+}
+
+vec2 gradSdRoundedRect(vec2 coord, vec2 halfSize, float radius) {
+  vec2 cornerCoord = abs(coord) - (halfSize - vec2(radius));
+  if (cornerCoord.x > 0.0 || cornerCoord.y > 0.0) {
+    return sign(coord) * safeNormalize(max(cornerCoord, 0.0));
+  } else {
+    float gradX = step(cornerCoord.y, cornerCoord.x);
+    return sign(coord) * vec2(gradX, 1.0 - gradX);
+  }
+}
+
+float circleMap(float x) {
+  return 1.0 - sqrt(1.0 - x * x);
+}
+
+void main() {
+  vec2 coord = FlutterFragCoord().xy;
+  vec2 halfSize = size * 0.5;
+  vec2 centeredCoord = (coord + offset) - halfSize;
+  float radius = radiusAt(centeredCoord, cornerRadii);
+
+  float sd = sdRoundedRect(centeredCoord, halfSize, radius);
+  if (-sd >= refractionHeight) {
+    fragColor = evalContent(coord);
+    return;
+  }
+  sd = min(sd, 0.0);
+
+  float d = circleMap(1.0 - -sd / refractionHeight) * refractionAmount;
+  float gradRadius = min(radius * 1.5, min(halfSize.x, halfSize.y));
+  vec2 grad = safeNormalize(gradSdRoundedRect(centeredCoord, halfSize, gradRadius) + depthEffect * safeNormalize(centeredCoord));
+
+  vec2 refractedCoord = coord + d * grad;
+  float dispersionIntensity = chromaticAberration * ((centeredCoord.x * centeredCoord.y) / (halfSize.x * halfSize.y));
+  vec2 dispersedCoord = d * grad * dispersionIntensity;
+
+  vec4 color = vec4(0.0);
+
+  vec4 red = evalContent(refractedCoord + dispersedCoord);
+  color.r += red.r / 3.5;
+  color.a += red.a / 7.0;
+
+  vec4 orange = evalContent(refractedCoord + dispersedCoord * (2.0 / 3.0));
+  color.r += orange.r / 3.5;
+  color.g += orange.g / 7.0;
+  color.a += orange.a / 7.0;
+
+  vec4 yellow = evalContent(refractedCoord + dispersedCoord * (1.0 / 3.0));
+  color.r += yellow.r / 3.5;
+  color.g += yellow.g / 3.5;
+  color.a += yellow.a / 7.0;
+
+  vec4 green = evalContent(refractedCoord);
+  color.g += green.g / 3.5;
+  color.a += green.a / 7.0;
+
+  vec4 cyan = evalContent(refractedCoord - dispersedCoord * (1.0 / 3.0));
+  color.g += cyan.g / 3.5;
+  color.b += cyan.b / 3.0;
+  color.a += cyan.a / 7.0;
+
+  vec4 blue = evalContent(refractedCoord - dispersedCoord * (2.0 / 3.0));
+  color.b += blue.b / 3.0;
+  color.a += blue.a / 7.0;
+
+  vec4 purple = evalContent(refractedCoord - dispersedCoord);
+  color.r += purple.r / 7.0;
+  color.b += purple.b / 3.0;
+  color.a += purple.a / 7.0;
+
+  fragColor = color;
+}
diff --git a/shaders/liquid_glass.frag b/shaders/liquid_glass.frag
new file mode 100644
index 0000000..9efea10
--- /dev/null
+++ b/shaders/liquid_glass.frag
@@ -0,0 +1,166 @@
+#version 460 core
+
+#include <flutter/runtime_effect.glsl>
+
+// 液态玻璃折射镜片 —— **Halcyon 源码逐行移植**。
+//
+// 来源：halcyon/app/src/main/java/com/ella/music/ui/components/liquid/Lens.kt
+//       （其自身 adapted from Kyant0/AndroidLiquidGlass，Apache-2.0）
+//       Halcyon 用 Compose 的 RuntimeShader（SkSL）实现，本文件是同一套算法
+//       在 Flutter fragment shader 上的等价物：把 content.eval(coord) 换成
+//       texture(u_backdrop, uv)，其余公式、常量、通道权重逐行对齐，
+//       不做"自己发挥"的近似。
+//
+// 【与原版 SkSL 的对应关系】
+//   原版 uniform        -> 本文件 uniform（槽位见下）
+//   size                -> u_size（引擎注入，槽 0-1）
+//   cornerRadii         -> u_radius（胶囊/正圆四角同值，故压成一个 float）
+//   refractionHeight    -> u_refractionHeight
+//   refractionAmount    -> u_refractionAmount（Dart 侧传**负值**，向内采样）
+//   depthEffect         -> u_depthEffect（0/1）
+//   chromaticAberration -> u_chromatic
+//   offset              -> 恒 0（Flutter 的滤镜纹理边界 = 形状边界；
+//                          原版留 padding 是为了 SkSL 越界采样，这里 d 恒向内）
+//
+// 【管线契约（dart:ui ImageFilter.shader）】
+//   - 第一个 float uniform 必须是 vec2：引擎注入输入纹理尺寸（槽 0-1，勿写）；
+//   - 第一个 sampler2D 由引擎绑定为滤镜输入（BackdropFilter 的背景层）；
+//   - GLES 后端 y 轴反向：所有采样经 uv2tex() 翻转；
+//   - 本项目约定：sampler 声明在所有 float uniform 之后（depth_parallax.frag:45）。
+uniform vec2 u_size;              // 槽 0-1（引擎注入，勿写）
+uniform float u_radius;           // 2: 圆角半径（物理 px，胶囊 = 高/2）
+uniform float u_refractionHeight; // 3: 折射带高度（物理 px，Halcyon 默认 24dp）
+uniform float u_refractionAmount; // 4: 折射位移（物理 px，**负值** = 向内）
+uniform float u_depthEffect;      // 5: 0/1，叠加向心的深度分量
+uniform float u_chromatic;        // 6: 色散强度 0-1（原版 7 通道采样）
+uniform float u_specular;         // 7: 边缘双光源高光强度 0-1
+uniform float u_edge;             // 8: 高光环带宽度（物理 px）
+
+uniform sampler2D u_backdrop;     // 槽 0：引擎绑定为滤镜输入
+
+out vec4 fragColor;
+
+// ---- 以下 4 个函数与 Lens.kt 的 ROUNDED_RECT_SDF 字符串逐行一致 ----
+
+// 像素中心可能正好落在内切矩形上（分数/奇数 dp 半径尤其常见），GLSL 的
+// normalize(0) 未定义，部分 GPU 会在镜片中央画出矩形接缝 —— 保持梯度有限。
+vec2 safeNormalize(vec2 value) {
+  return value / max(length(value), 0.0001);
+}
+
+float sdRoundedRect(vec2 coord, vec2 halfSize, float radius) {
+  vec2 cornerCoord = abs(coord) - (halfSize - vec2(radius));
+  float outside = length(max(cornerCoord, 0.0)) - radius;
+  float inside = min(max(cornerCoord.x, cornerCoord.y), 0.0);
+  return outside + inside;
+}
+
+vec2 gradSdRoundedRect(vec2 coord, vec2 halfSize, float radius) {
+  vec2 cornerCoord = abs(coord) - (halfSize - vec2(radius));
+  if (cornerCoord.x > 0.0 || cornerCoord.y > 0.0) {
+    return sign(coord) * safeNormalize(max(cornerCoord, 0.0));
+  } else {
+    // 直边段：梯度只会落在两个轴上，用 step 而不是比较分支，避免 diverging branch
+    float gradX = step(cornerCoord.y, cornerCoord.x);
+    return sign(coord) * vec2(gradX, 1.0 - gradX);
+  }
+}
+
+// 原版剖面：外缘 1 → 带内缘 0（**凸**形，与 sqrt(1-x^2) 互补，别写反）
+float circleMap(float x) {
+  return 1.0 - sqrt(1.0 - x * x);
+}
+
+vec2 uv2tex(vec2 uv) {
+#ifdef IMPELLER_TARGET_OPENGLES
+  return vec2(uv.x, 1.0 - uv.y);
+#else
+  return uv;
+#endif
+}
+
+// content.eval(coord) 的等价物：coord 为滤镜纹理内的像素坐标
+vec4 evalContent(vec2 coord) {
+  vec2 uv = clamp(coord / u_size, vec2(0.0), vec2(1.0));
+  return texture(u_backdrop, uv2tex(uv));
+}
+
+void main() {
+  vec2 coord = FlutterFragCoord().xy;
+  vec2 halfSize = u_size * 0.5;
+  vec2 centeredCoord = coord - halfSize;
+  float radius = min(u_radius, min(halfSize.x, halfSize.y));
+
+  float sd = sdRoundedRect(centeredCoord, halfSize, radius);
+
+  // 带外：原样透传（与 content.eval(coord) 等价）
+  if (-sd >= u_refractionHeight) {
+    fragColor = evalContent(coord);
+    return;
+  }
+  sd = min(sd, 0.0);
+
+  // 折射位移量：外缘最大 → 带内缘 0（circleMap 的输入是归一化深度）。
+  // max() 防 refractionHeight=0 时除零成 inf（参数面板把它拖到 0 会走到这里）。
+  float band = 1.0 - (-sd) / max(u_refractionHeight, 0.001);
+  float d = circleMap(clamp(band, 0.0, 1.0)) * u_refractionAmount;
+
+  float gradRadius = min(radius * 1.5, min(halfSize.x, halfSize.y));
+  vec2 grad = safeNormalize(
+      gradSdRoundedRect(centeredCoord, halfSize, gradRadius) +
+      u_depthEffect * safeNormalize(centeredCoord));
+
+  vec2 refractedCoord = coord + d * grad;
+
+  // 色散：偏移量在对角区域最强（原版 dispersionIntensity = ca * x*y/(hx*hy)）
+  float dispersionIntensity =
+      u_chromatic * ((centeredCoord.x * centeredCoord.y) / (halfSize.x * halfSize.y));
+  vec2 dispersedCoord = d * grad * dispersionIntensity;
+
+  // ---- 7 通道色散采样，权重与 Lens.kt 的 ROUNDED_RECT_REFRACTION_WITH_DISPERSION_SHADER 逐行一致 ----
+  vec4 color = vec4(0.0);
+
+  vec4 red = evalContent(refractedCoord + dispersedCoord);
+  color.r += red.r / 3.5;
+  color.a += red.a / 7.0;
+
+  vec4 orange = evalContent(refractedCoord + dispersedCoord * (2.0 / 3.0));
+  color.r += orange.r / 3.5;
+  color.g += orange.g / 7.0;
+  color.a += orange.a / 7.0;
+
+  vec4 yellow = evalContent(refractedCoord + dispersedCoord * (1.0 / 3.0));
+  color.r += yellow.r / 3.5;
+  color.g += yellow.g / 3.5;
+  color.a += yellow.a / 7.0;
+
+  vec4 green = evalContent(refractedCoord);
+  color.g += green.g / 3.5;
+  color.a += green.a / 7.0;
+
+  vec4 cyan = evalContent(refractedCoord - dispersedCoord * (1.0 / 3.0));
+  color.g += cyan.g / 3.5;
+  color.b += cyan.b / 3.0;
+  color.a += cyan.a / 7.0;
+
+  vec4 blue = evalContent(refractedCoord - dispersedCoord * (2.0 / 3.0));
+  color.b += blue.b / 3.0;
+  color.a += blue.a / 7.0;
+
+  vec4 purple = evalContent(refractedCoord - dispersedCoord);
+  color.r += purple.r / 7.0;
+  color.b += purple.b / 3.0;
+  color.a += purple.a / 7.0;
+
+  // ---- BloomStroke 双光源高光（Halcyon 的 Highlight 由 miuix 另出一层，
+  //      这里沿用同一观感的近似：左上主光 3 次幂 + 右下副光 4 次幂 × rim）----
+  float depth = -sd;
+  float rim = 1.0 - smoothstep(0.0, max(u_edge, 0.001), depth);
+  vec2 l1 = normalize(vec2(-0.6, -0.8));
+  vec2 l2 = normalize(vec2(0.7, 0.7));
+  float s1 = pow(max(dot(grad, l1), 0.0), 3.0) * rim * u_specular;
+  float s2 = pow(max(dot(grad, l2), 0.0), 4.0) * rim * u_specular * 0.55;
+  color.rgb += vec3(s1 + s2);
+
+  fragColor = vec4(color.rgb, 1.0);
+}
