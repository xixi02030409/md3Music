+class _ResidentBarSuppressorState extends State<ResidentBarSuppressor> {
+  static int _activeCount = 0;
+
+  @override
+  void initState() {
+    super.initState();
+    _activeCount++;
+    _sync();
+  }
+
+  @override
+  void dispose() {
+    _activeCount--;
+    _sync();
+    super.dispose();
+  }
