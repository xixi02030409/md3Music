+// 源：halcyon/.../components/FloatingBottomBar.kt（594 行）
+//     + animation/DampedDragAnimation.kt（222 行，弹簧参数 1:1）
+//
+// 结构（原版 Box 内三层，绘制顺序即先后）：
+//   1 本体 Row：dropShadow → 玻璃（lens 24/24 + highlight 0.75）→ height 64 + padding 4
+//   2 隐藏副本 Row：alpha=0 + layerBackdrop（把图标内容录成 backdrop 给 pill 折射）。
+//     **Flutter 没有 layerBackdrop 等价物**（无法把已布局 widget 录成 backdrop），
+//     这一层缺失，因此 pill 只折射真实背景、不折射图标本身 —— 已知差异。
+//   3 指示器 pill：translationX = value×tabWidth + panelOffset；
+//     按压时 lens(10dp·p, 14dp·p, depthEffect, chroma 0.5) + 面板色淡出 + 0.03 黑；
+//     形变 scaleX/scaleY 来自拖拽速度。
+//
+// DampedDrag 五条弹簧（dampingRatio / stiffness）：
+//   value 1.0/1000、velocity 0.5/300、pressProgress 1.0/1000、scaleX 0.6/250、scaleY 0.7/250
+//   pressedScale = 78f/56f = 1.3929
+import 'dart:math' as math;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/physics.dart';
+import 'package:flutter/scheduler.dart';
