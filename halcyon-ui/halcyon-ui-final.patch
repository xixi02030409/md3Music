diff --git a/shaders/halcyon_highlight.frag b/shaders/halcyon_highlight.frag
new file mode 100644
index 0000000..e544783
--- /dev/null
+++ b/shaders/halcyon_highlight.frag
@@ -0,0 +1,103 @@
+#version 460 core
+#include <flutter/runtime_effect.glsl>
+
+// 源：miuix-kmp · miuix-blur/.../internal/Shaders.kt 的
+//     buildBloomStrokeShader(dualPeak = false)（本地副本 ui-port/miuix-blur/internal/Shaders.kt:440-531）
+//     + HighlightStyle.kt 的 applyLightUniforms / BloomStroke 默认档
+//
+// 这是 Halcyon GlassPill 里 `highlight = { Highlight.Default... }` 真正画的那一层：
+// 圆角矩形 SDF → 半球法线 → 两盏方向光的平方衰减 → 乘 highlightAlpha。
+//
+// 与 miuix 的差别仅两点（都是 Flutter 侧限制，非算法）：
+//   · `layout(color)` 修饰去掉，颜色由 Dart 传分量
+//   · 通过 Paint.shader 直接绘制（不是 backdrop），所以坐标是画布逻辑像素
+//
+// 槽位：0-1 uSize  2-3 halfView  4-5 halfViewFloor  6-9 cornerRadii
+//      10 strokeWidth  11 innerBlurRadius  12 innerBlurRadiusSq  13 highlightAlpha
+//      14 strokeAlphaMul  15-17 lightDir1  18 lightIntensity1  19-21 lightDir2
+//      22 lightIntensity2  23-24 axis1  25-26 axis2
+uniform vec2 uSize;
+uniform vec2 halfView;
+uniform vec2 halfViewFloor;
+uniform vec4 cornerRadii;
+uniform float strokeWidth;
+uniform float innerBlurRadius;
+uniform float innerBlurRadiusSq;
+uniform float highlightAlpha;
+uniform float strokeAlphaMul;
+uniform vec3 lightDir1;
+uniform float lightIntensity1;
+uniform vec3 lightDir2;
+uniform float lightIntensity2;
+uniform vec2 axis1;
+uniform vec2 axis2;
+
+out vec4 fragColor;
+
+float pickRadius(vec2 fragCoord, vec4 radii) {
+  vec2 up = fragCoord.y < halfView.y ? radii.xy : radii.zw;
+  return fragCoord.x < halfView.x ? up.x : up.y;
+}
+
+float roundedBoxSDF(vec2 pos, vec2 halfSize, float radius) {
+  radius = min(radius, min(halfSize.x, halfSize.y));
+  vec2 d = pos - halfSize + radius;
+  return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0) - radius;
+}
+
+vec3 getNormal(vec2 fragCoord, float sdf, float R) {
+  vec2 xy = fragCoord - halfViewFloor;
+  vec2 xy_a = abs(xy);
+  float t = smoothstep(-innerBlurRadius, 0.0, sdf);
+  float z = sqrt(max(innerBlurRadiusSq - t * t, 0.0));
+  vec3 coord = vec3(xy_a, -z);
+
+  vec2 corner = halfView - R;
+  corner.x = min(corner.x, xy_a.x);
+  corner.y = min(corner.y, xy_a.y);
+
+  vec2 dir = normalize(coord.xy - corner);
+  corner += dir * (R - innerBlurRadius);
+
+  if (any(lessThan(xy_a, corner))) {
+    return vec3(0.0, 0.0, -1.0);
+  }
+
+  vec2 signal = sign(xy);
+  vec3 n = normalize(coord - vec3(corner, 0.0));
+  n.xy *= signal;
+  return n;
+}
+
+void main() {
+  vec2 fragCoord = FlutterFragCoord().xy;
+  vec2 xy = abs(fragCoord - halfView);
+
+  float originRadius = pickRadius(fragCoord, cornerRadii);
+  float R = max(originRadius, innerBlurRadius);
+
+  if (all(lessThan(xy, halfView - R))) {
+    fragColor = vec4(0.0);
+    return;
+  }
+
+  float sdf = roundedBoxSDF(xy, halfView, originRadius);
+  float outMask = smoothstep(0.0, -1.0, sdf);
+  float strokeAlpha = smoothstep(-strokeWidth, -strokeWidth + 1.0, sdf);
+
+  // miuix：stroke = uStrokeColor * sa，叠加即 strokeColor.rgb * strokeColor.a * sa²
+  // 这里 strokeColor 固定白，用 strokeAlphaMul 承载其 alpha（Highlight.Default = 0.05）
+  vec3 rgb = vec3(strokeAlphaMul * strokeAlpha * strokeAlpha);
+
+  vec3 n = getNormal(fragCoord, sdf, R);
+
+  float falloff1 = max(dot(vec3(axis1, 0.0), n), 0.0);
+  float light1 = clamp(dot(n, lightDir1) * falloff1, 0.0, 1.0);
+  rgb += (light1 * light1 * lightIntensity1) * vec3(1.0);
+
+  float falloff2 = max(dot(vec3(axis2, 0.0), n), 0.0);
+  float light2 = clamp(dot(n, lightDir2) * falloff2, 0.0, 1.0);
+  rgb += (light2 * light2 * lightIntensity2) * vec3(1.0);
+
+  fragColor = vec4(rgb * highlightAlpha, 1.0) * outMask;
+}
diff --git a/shaders/halcyon_lens.frag b/shaders/halcyon_lens.frag
new file mode 100644
index 0000000..e9b90d8
--- /dev/null
+++ b/shaders/halcyon_lens.frag
@@ -0,0 +1,90 @@
+#version 460 core
+#include <flutter/runtime_effect.glsl>
+
+// 源：halcyon/.../components/liquid/Lens.kt:125-159
+//     ROUNDED_RECT_REFRACTION_SHADER（无色散变体）
+//     该文件 adapted from Kyant0/AndroidLiquidGlass (Apache-2.0)
+//
+// 机械替换：uniform shader content → sampler2D；content.eval(coord) → sampleContent(coord)；
+// half4 main → void main + out fragColor。算法与常量未改。
+//
+// uniform 槽位（Flutter 不注入任何 uniform，全部由 Dart 写）：
+//  0-1 texSize  2-3 size  4-5 offset  6-9 cornerRadii
+//  10 refractionHeight  11 refractionAmount  12 depthEffect
+uniform vec2 uTexSize;
+uniform vec2 uOrigin;   // 2-3 盒子的屏幕左上角（物理 px）
+uniform vec2 size;
+uniform vec2 offset;
+uniform vec4 cornerRadii;
+uniform float refractionHeight;
+uniform float refractionAmount;
+uniform float depthEffect;
+
+uniform sampler2D content;
+
+out vec4 fragColor;
+
+// coord 是**盒子局部坐标**（已减去 uOrigin）。BackdropFilter 的输入纹理就是
+// 这块盒子的内容，所以 local / texSize 就是 uv。
+vec4 sampleContent(vec2 coord) {
+  vec2 uv = coord / max(uTexSize, vec2(1.0));
+  return texture(content, clamp(uv, vec2(0.0), vec2(1.0)));
+}
+
+// —— Lens.kt 的 ROUNDED_RECT_SDF，四个函数逐行一致 ——
+vec2 safeNormalize(vec2 value) { return value / max(length(value), 0.0001); }
+
+float radiusAt(vec2 coord, vec4 radii) {
+  if (coord.x >= 0.0) {
+    if (coord.y <= 0.0) return radii.y;
+    else return radii.z;
+  } else {
+    if (coord.y <= 0.0) return radii.x;
+    else return radii.w;
+  }
+}
+
+float sdRoundedRect(vec2 coord, vec2 halfSize, float radius) {
+  vec2 cornerCoord = abs(coord) - (halfSize - vec2(radius));
+  float outside = length(max(cornerCoord, 0.0)) - radius;
+  float inside = min(max(cornerCoord.x, cornerCoord.y), 0.0);
+  return outside + inside;
+}
+
+vec2 gradSdRoundedRect(vec2 coord, vec2 halfSize, float radius) {
+  vec2 cornerCoord = abs(coord) - (halfSize - vec2(radius));
+  if (cornerCoord.x > 0.0 || cornerCoord.y > 0.0) {
+    return sign(coord) * safeNormalize(max(cornerCoord, 0.0));
+  } else {
+    float gradX = step(cornerCoord.y, cornerCoord.x);
+    return sign(coord) * vec2(gradX, 1.0 - gradX);
+  }
+}
+
+float circleMap(float x) { return 1.0 - sqrt(1.0 - x * x); }
+
+void main() {
+  // FlutterFragCoord 在 ImageFilter.shader 里是**屏幕坐标**，不是局部坐标。
+  // 之前直接拿它除盒子尺寸，uv 跑到 0..8 这种越界值，采样被 clamp 到屏幕边缘
+  // —— 表现就是"页面顶部的内容被翻转着映进胶囊"。这里先减掉盒子原点。
+  vec2 coord = FlutterFragCoord().xy - uOrigin;
+  vec2 halfSize = size * 0.5;
+  vec2 centeredCoord = (coord + offset) - halfSize;
+  float radius = radiusAt(centeredCoord, cornerRadii);
+
+  float sd = sdRoundedRect(centeredCoord, halfSize, radius);
+  if (-sd >= refractionHeight) {
+    fragColor = sampleContent(coord);
+    return;
+  }
+  sd = min(sd, 0.0);
+
+  float d = circleMap(1.0 - -sd / max(refractionHeight, 0.0001)) * refractionAmount;
+  float gradRadius = min(radius * 1.5, min(halfSize.x, halfSize.y));
+  vec2 grad = safeNormalize(
+      gradSdRoundedRect(centeredCoord, halfSize, gradRadius) +
+      depthEffect * safeNormalize(centeredCoord));
+
+  vec2 refractedCoord = coord + d * grad;
+  fragColor = sampleContent(refractedCoord);
+}
