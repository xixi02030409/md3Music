+// Halcyon GlassEffect.kt 的 Flutter 等价物 —— 参数与取色口径逐条搬。
+//
+// 源：ui-port/halcyon/.../ui/components/GlassEffect.kt
+//
+// 这个文件里没有任何"设计"，全是原版写死的数：谁在亮色用多少、暗色用多少、
+// 液态档和模糊档各是什么 alpha。搬过来才能保证两边观感是同一条曲线。
+import 'package:flutter/material.dart';
+
+/// BottomBarGlassEffect（原版枚举只有两档）。
+enum HalcyonGlassEffect {
+  /// 纯高斯模糊档。
+  blur,
+
+  /// 液态玻璃档：轻模糊 + 折射 + 色散。
+  liquidGlass,
+}
+
+/// BottomBarLiquidGlassConfig（原版默认值，见 GlassEffect.kt:17-22）。
+@immutable
+class HalcyonLiquidGlassConfig {
+  const HalcyonLiquidGlassConfig({
+    this.blurRadiusDp = 6.0,
+    this.refractionHeightDp = 24.0,
+    this.refractionAmountDp = 24.0,
+    this.chromaticAberration = 0.0,
+  });
+
+  final double blurRadiusDp;
+  final double refractionHeightDp;
+  final double refractionAmountDp;
+  final double chromaticAberration;
+}
+
+/// bottomBarGlassContainerColor（GlassEffect.kt:59-76）。
+///
+/// 注意参数默认值：亮/暗实底 0.56/0.58，液态档 0.38/0.42 —— GlassPill 调用时
+/// 会把液态档覆盖成 0.34/0.38（GlassPill.kt:38-45），两处默认不同是原版的样子。
+Color halcyonGlassContainerColor({
+  required bool isLight,
+  required HalcyonGlassEffect glassEffect,
+  double lightAlpha = 0.56,
+  double darkAlpha = 0.58,
+  double lightLiquidAlpha = 0.38,
+  double darkLiquidAlpha = 0.42,
+}) {
+  final double alpha = switch (glassEffect) {
+    HalcyonGlassEffect.blur => isLight ? lightAlpha : darkAlpha,
+    HalcyonGlassEffect.liquidGlass =>
+      isLight ? lightLiquidAlpha : darkLiquidAlpha,
+  };
+  return isLight
+      ? Colors.white.withValues(alpha: alpha)
+      : const Color(0xFF111114).withValues(alpha: alpha);
+}
+
+/// bottomBarGlassHighlightAlpha（GlassEffect.kt:78-82）。
+double halcyonGlassHighlightAlpha({
+  required bool isLight,
+  required HalcyonGlassEffect glassEffect,
+}) => switch (glassEffect) {
+  HalcyonGlassEffect.blur => isLight ? 0.22 : 0.14,
+  HalcyonGlassEffect.liquidGlass => isLight ? 0.18 : 0.10,
+};
+
+/// Color.simpleLuminance()（GlassEffect.kt:84-86）——**未做 gamma 校正的**
+/// 线性加权，与 Color.computeLuminance() 不是一回事，别替换。
+double simpleLuminance(Color color) =>
+    0.2126 * color.r + 0.7152 * color.g + 0.0722 * color.b;
diff --git a/lib/widgets/halcyon/glass_pill.dart b/lib/widgets/halcyon/glass_pill.dart
new file mode 100644
index 0000000..f8a0c46
--- /dev/null
+++ b/lib/widgets/halcyon/glass_pill.dart
@@ -0,0 +1,160 @@
+// Halcyon GlassPill.kt 的 Flutter 等价物 —— **一个组件承担全部玻璃层**。
+//
+// 源：ui-port/halcyon/.../ui/components/GlassPill.kt
+//
+// 原版结构（Box 的 modifier 链，顺序即绘制顺序）：
+//   .clip(resolvedShape)
+//   .dropShadow(shape, Shadow(radius = 10.dp, alpha = if (isInDark) 0.2f else 0.1f))
+//   .then(drawBackdrop(effects = { blur(6dp); lens(24dp, 24dp, chroma) },
+//                      highlight = Highlight.Default.copy(alpha = 0.18/0.10),
+//                      onDrawSurface = { drawRect(containerColor) }))
+//
+// 搬过来就是本文件：调用方只给形状半径 + 内容，玻璃的层叠顺序由这里保证。
+// 之前把 lens 当独立滤镜撒在底栏/播放条各自的 Stack 里，每处各拼一遍顺序 ——
+// 那不是搬，也必然各处不一致。
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+
+import 'glass_effect.dart';
+import 'lens.dart';
+
+class HalcyonGlassPill extends StatelessWidget {
+  const HalcyonGlassPill({
+    super.key,
+    required this.cornerRadius,
+    required this.isLight,
+    required this.child,
+    this.glassEffect = HalcyonGlassEffect.liquidGlass,
+    this.liquidConfig = const HalcyonLiquidGlassConfig(),
+    this.disableRefraction = false,
+    this.surfaceColor,
+    this.shadowAlphaOverride,
+  });
+
+  /// resolvedShape 的圆角（dp，原版 coerceIn(0f, 32f)）。
+  final double cornerRadius;
+
+  final bool isLight;
+  final Widget child;
+
+  final HalcyonGlassEffect glassEffect;
+  final HalcyonLiquidGlassConfig liquidConfig;
+  final bool disableRefraction;
+
+  /// onDrawSurface 画的底色；null → bottomBarGlassContainerColor（GlassPill 的
+  /// 0.34/0.38 液态档覆盖值，见 GlassPill.kt:38-45）。
+  final Color? surfaceColor;
+
+  /// 原版 dropShadow 的 alpha（暗 0.2 / 亮 0.1）；个别场景要更淡时覆盖。
+  final double? shadowAlphaOverride;
+
+  @override
+  Widget build(BuildContext context) {
+    final bool isDark = !isLight;
+    final double radius = cornerRadius.clamp(0.0, 32.0);
+    final Color surface =
+        surfaceColor ??
+        halcyonGlassContainerColor(
+          isLight: isLight,
+          glassEffect: glassEffect,
+          lightLiquidAlpha: 0.34, // GlassPill.kt:43
+          darkLiquidAlpha: 0.38, // GlassPill.kt:44
+        );
+    final double highlight = halcyonGlassHighlightAlpha(
+      isLight: isLight,
+      glassEffect: glassEffect,
+    );
+    final double shadowAlpha =
+        shadowAlphaOverride ?? (isDark ? 0.20 : 0.10); // GlassPill.kt:83
+
+    return DecoratedBox(
+      // dropShadow 必须画在裁剪层外面，否则会被圆角裁掉。
+      decoration: BoxDecoration(
+        borderRadius: BorderRadius.circular(radius),
+        boxShadow: <BoxShadow>[
+          BoxShadow(
+            color: Colors.black.withValues(alpha: shadowAlpha),
+            blurRadius: 10, // Shadow(radius = 10.dp)
+          ),
+        ],
+      ),
+      child: ClipRRect(
+        borderRadius: BorderRadius.circular(radius),
+        child: LayoutBuilder(
+          builder: (BuildContext context, BoxConstraints c) {
+            final double w = c.maxWidth;
+            final double h = c.maxHeight;
+            final bool liquid = glassEffect == HalcyonGlassEffect.liquidGlass;
+            final double pad = liquid ? liquidConfig.refractionAmountDp : 0;
+            return Stack(
+              // 镜片盒子要比形状大 2×padding（BackdropEffectScope.padding 的
+              // 几何含义），所以这里不能裁；形状仍由外层 ClipRRect 负责。
+              clipBehavior: Clip.none,
+              children: <Widget>[
+                // 1) effects：blur → lens（原版顺序）
+                if (liquid) ...<Widget>[
+                  if (liquidConfig.blurRadiusDp > 0)
+                    Positioned.fill(
+                      child: BackdropFilter(
+                        filter: ui.ImageFilter.blur(
+                          sigmaX: liquidConfig.blurRadiusDp,
+                          sigmaY: liquidConfig.blurRadiusDp,
+                        ),
+                        child: const SizedBox.expand(),
+                      ),
+                    ),
+                  if (!disableRefraction &&
+                      liquidConfig.refractionHeightDp > 0 &&
+                      liquidConfig.refractionAmountDp > 0)
+                    Positioned(
+                      left: -pad,
+                      top: -pad,
+                      right: -pad,
+                      bottom: -pad,
+                      child: IgnorePointer(
+                        child: HalcyonLens(
+                          shapeSize: Size(w, h),
+                          cornerRadii: Radius.circular(radius),
+                          refractionHeight: liquidConfig.refractionHeightDp,
+                          refractionAmount: liquidConfig.refractionAmountDp,
+                          chromaticAberration: liquidConfig.chromaticAberration,
+                        ),
+                      ),
+                    ),
+                ],
+                // 2) onDrawSurface：drawRect(containerColor)
+                Positioned.fill(
+                  child: IgnorePointer(child: ColoredBox(color: surface)),
+                ),
+                // 3) highlight：miuix 的 Highlight.Default 无源码，用 45° 双光带
+                //    近似（观感档位按 highlight alpha 走，不另设参数）。
+                Positioned.fill(
+                  child: IgnorePointer(
+                    child: DecoratedBox(
+                      decoration: BoxDecoration(
+                        borderRadius: BorderRadius.circular(radius),
+                        gradient: LinearGradient(
+                          begin: Alignment.topLeft,
+                          end: Alignment.bottomRight,
+                          colors: <Color>[
+                            Colors.white.withValues(alpha: highlight),
+                            Colors.white.withValues(alpha: 0.0),
+                            Colors.white.withValues(alpha: highlight * 0.5),
+                          ],
+                          stops: const <double>[0.0, 0.55, 1.0],
+                        ),
+                      ),
+                    ),
+                  ),
+                ),
+                // 4) content
+                Positioned.fill(child: child),
+              ],
+            );
+          },
+        ),
+      ),
+    );
+  }
+}
