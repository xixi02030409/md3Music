+  image_picker: ^1.1.2
+  # Windows 原生文件/目录选择（背景图、字体与本地音乐目录）
+  file_selector: ^1.1.0
+  # 诊断日志导出：系统分享面板（Android ACTION_SEND / Windows 系统分享），自带 FileProvider
+  share_plus: ^13.3.0
+  # 诊断日志导出：纯 Dart zip 打包（无原生代码，跨平台）
+  archive: ^4.0.7
