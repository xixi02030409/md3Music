+                                child: GestureDetector(
+                                  behavior: HitTestBehavior.opaque,
+                                  onTap: () {
+                                    if (i != widget.selectedIndex) {
+                                      widget.onSelected(i);
+                                    }
+                                    _animateTo(i.toDouble());
+                                  },
+                                  child: Center(
+                                    child: widget.itemBuilder(
+                                      context,
+                                      i,
+                                      i ==
+                                          _value.value.round().clamp(
+                                            0,
+                                            widget.tabCount - 1,
+                                          ),
+                                    ),
+                                  ),
+                                ),
+                              ),
+                          ],
+                        ),
+                      ),
+                    ),
+                  ),
+                ),
+              ),
+              if (_tabWidth > 0)
