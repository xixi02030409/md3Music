-    _pullRelease.dispose();
-    _snap.dispose();
-    _lift.dispose();
-    _dragOffset.dispose();
-    _morph.dispose();
-    _spin.dispose();
-    _progressTimer?.cancel();
-    _progressTimer = null;
-    _progress.dispose();
-    super.dispose();
-  }
