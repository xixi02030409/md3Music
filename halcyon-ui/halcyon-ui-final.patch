-  required bool floatingEnabled,
-  required bool onPrimaryPages,
-  required bool pageIsPrimaryNav,
-}) {
-  if (!floatingEnabled) return 0.0;
-  if (!onPrimaryPages && pageIsPrimaryNav) return 0.0;
-  return 1.0;
-}
