+  image: ^4.12.0
+  video_player_win: ^3.2.2     # video_player 的 Windows 实现（Media Foundation）
+  dlna_dart: ^0.1.0
+  webview_flutter: ^4.10.0
+  flutter_secure_storage: ^10.3.1
+  # 原生 Toast 提示（替代 SnackBar 通知）；10.0.0 起 compileSdk 满足项目 36 要求
+  fluttertoast: ^10.0.0
+  # TTML 歌词解析：Apple Music 风格 XML（Timed Text Markup Language）
+  xml: ^6.5.0
+  m3e_core: ^1.1.4
