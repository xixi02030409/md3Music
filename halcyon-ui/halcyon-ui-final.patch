+dev_dependencies:
+  flutter_test:
+    sdk: flutter
+  integration_test:
+    sdk: flutter
+  flutter_lints: ^6.0.0
+  fake_async: ^1.3.1
+  analyzer: ^10.2.0
+  video_player_platform_interface: ^6.9.0
