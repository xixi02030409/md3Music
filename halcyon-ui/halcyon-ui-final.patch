+publish_to: 'none'
+version: 6.2.0+53
+
+environment:
+  sdk: ^3.12.0
+
+dependencies:
+  flutter:
+    sdk: flutter
+
+  cupertino_icons: ^1.0.8
+  # just_audio 0.10.6 本地 fork：注入可拦截 AudioSink 的 RenderersFactory（USB 独占输出）
+  just_audio:
+    path: third_party/just_audio
+  audio_session: ^0.1.18
+  http: ^1.2.1
+  # TV 构建焦点遍历引擎（fluttercandies/dpad），仅 --dart-define=MD3_TV=true 时生效，正常构建树摇剔除
+  dpad: ^3.0.0
+  provider: ^6.1.2
+  cached_network_image: ^3.3.1
+  sensors_plus: ^7.1.0
+  crypto: ^3.0.3
+  flutter_cache_manager: ^3.4.1
+  shared_preferences: ^2.5.0
+  # 2.5.0 改用 JNI 后无法解码旧原生 Integer 偏好，覆盖安装会在首帧前白屏。
+  # 固定兼容版本；公开导出不携带 lock，不能仅依赖 lock 阻止升级。
+  shared_preferences_android: 2.4.28
+  permission_handler: ^12.0.0
+  record: ^6.1.1
+  path_provider: ^2.1.0
+  quick_actions: ^1.0.7
+  sqflite: 2.3.3+1
+  # 听歌统计本地库：Windows/Linux 桌面 FFI 实现（移动端仍走 sqflite 平台实现）
+  sqflite_common_ffi: ^2.3.3
+  intl: ^0.20.2
+  dio: ^5.4.0
+  dio_cookie_manager: ^3.1.1
+  cookie_jar: ^4.0.8
+  url_launcher: ^6.3.0
+  package_info_plus: ^10.2.1
+  ffi: ^2.1.0
+  palette_generator: ^0.3.3+7
+  dynamic_color: ^1.7.0
+  material_color_utilities: ^0.13.0
+  audio_metadata_reader: ^1.4.1
+  video_player: ^2.9.2
+  chewie: ^1.8.5
+  # MV 弹幕渲染层：CustomPainter 直绘，纯 Dart（无原生代码，不影响 Android 打包链路）
+  # MIT 许可，与本项目 AGPL-3.0 兼容
+  canvas_danmaku: ^0.3.3
+  # Windows 桌面实现（均只声明 windows 平台，Android 完全不编译/注册，零影响）
+  # vendor 自 pub 0.2.3，仅加一行 mediaPlayer.CommandManager().IsEnabled(false)
+  # （上游 master 已修但未发版）：关掉系统自动 SMTC 集成，否则播控中心会在
+  # runner 手动发布的完整卡片之外再多出一张空白卡片。上游发版后可移除本 fork。
+  just_audio_windows:
+    path: third_party/just_audio_windows
+  # 3D 封面 Windows 侧推理：纯 Dart ONNX Runtime 绑定（vendored 自 onnxruntime_plus
+  # 1.5.0 的 lib/src，**不是 plugin**，不会给 Android 注入 onnxruntime so）。
+  ort_dart:
