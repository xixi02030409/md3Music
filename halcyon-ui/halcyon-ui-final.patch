+  # 纯 Dart（仅依赖 vector_math），MIT，Flutter 3.10+，不影响 Android 打包链路
+  m3_expressive: ^1.0.0
+  # 网络类型检测（WiFi / 移动网络）：音质按网络分别设置
+  connectivity_plus: ^7.0.0
