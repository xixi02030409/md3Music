+      alignment: Alignment.center,
+      transform: Matrix4.identity()..scale(sx, sy, 1.0),
+      child: HalcyonGlassPill(
+        cornerRadius: 28,
+        isLight: !isDark,
+        surfaceColor: const Color(0x00000000),
+        shadowAlphaOverride: 0,
+        liquidConfig: HalcyonLiquidGlassConfig(
+          blurRadiusDp: 0, // pill 的 effects 里只有 lens
+          refractionHeightDp: 10.0 * press,
+          refractionAmountDp: 14.0 * press,
+          chromaticAberration: 0.5,
+        ),
+        // 注意：Halcyon 的 iosIndicatorSpecular 是 dualPeak=true，走的是
+        // BLOOM_STROKE_SHADER_DUAL（每个光在对角两侧各出一个峰）。当前 shader 只
+        // 实现了 single 分支，且 pill 是胶囊（radius == 半高）会踩到 miuix
+        // getNormal 的 corner.y = halfSize.y - R = 0 边界情况，真机上表现为
+        // pill 左端一块被切一半的灰块。过渡期先用默认档（MiddleLight）保底。
+        highlightOverride: Highlight(alpha: press),
+        child: Stack(
+          fit: StackFit.expand,
+          children: <Widget>[
+            ColoredBox(
+              color: (isDark ? Colors.white : Colors.black).withValues(
+                alpha: 0.10 * (1 - press),
+              ),
+            ),
+            if (press > 0)
+              ColoredBox(color: Colors.black.withValues(alpha: 0.03 * press)),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+/// FloatingBottomBarItem（.kt:143-159）
+class HalcyonBottomBarItem extends StatelessWidget {
+  const HalcyonBottomBarItem({
+    super.key,
+    required this.icon,
+    this.label,
+    required this.selected,
+    required this.contentColor,
+    required this.activeColor,
+  });
+
+  final Widget icon;
+  final String? label;
+  final bool selected;
+  final Color contentColor;
+  final Color activeColor;
+
+  @override
+  Widget build(BuildContext context) {
+    final Color color = selected ? activeColor : contentColor;
+    return IconTheme.merge(
+      data: IconThemeData(color: color, size: 26),
+      child: DefaultTextStyle.merge(
+        style: TextStyle(
+          fontSize: 11,
+          height: 1.0,
+          color: color,
+          fontWeight: selected ? FontWeight.w600 : FontWeight.w400,
+        ),
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          mainAxisAlignment: MainAxisAlignment.center,
+          children: <Widget>[
+            icon,
+            if (label != null && label!.isNotEmpty) ...<Widget>[
+              const SizedBox(height: 1),
+              Text(label!, maxLines: 1, overflow: TextOverflow.ellipsis),
+            ],
+          ],
+        ),
+      ),
+    );
+  }
+}
diff --git a/lib/widgets/halcyon/glass_effect.dart b/lib/widgets/halcyon/glass_effect.dart
new file mode 100644
index 0000000..0e8d405
--- /dev/null
+++ b/lib/widgets/halcyon/glass_effect.dart
@@ -0,0 +1,53 @@
+// 源：halcyon/.../components/GlassEffect.kt
+// 参数与取色口径 1:1 搬：BottomBarGlassEffect 枚举、BottomBarLiquidGlassConfig 默认值、
+// bottomBarGlassContainerColor、bottomBarGlassHighlightAlpha、simpleLuminance。
+import 'package:flutter/material.dart';
+
+enum HalcyonGlassEffect { blur, liquidGlass }
+
+@immutable
+class HalcyonLiquidGlassConfig {
+  const HalcyonLiquidGlassConfig({
+    this.blurRadiusDp = 6.0,
+    this.refractionHeightDp = 24.0,
+    this.refractionAmountDp = 24.0,
+    this.chromaticAberration = 0.0,
+  });
+
+  final double blurRadiusDp;
+  final double refractionHeightDp;
+  final double refractionAmountDp;
+  final double chromaticAberration;
+}
+
+/// GlassEffect.kt:59-76
+Color halcyonGlassContainerColor({
+  required bool isLight,
+  required HalcyonGlassEffect glassEffect,
+  double lightAlpha = 0.56,
+  double darkAlpha = 0.58,
+  double lightLiquidAlpha = 0.38,
+  double darkLiquidAlpha = 0.42,
+}) {
+  final double alpha = switch (glassEffect) {
+    HalcyonGlassEffect.blur => isLight ? lightAlpha : darkAlpha,
+    HalcyonGlassEffect.liquidGlass =>
+      isLight ? lightLiquidAlpha : darkLiquidAlpha,
+  };
+  return isLight
+      ? Colors.white.withValues(alpha: alpha)
+      : const Color(0xFF111114).withValues(alpha: alpha);
+}
+
+/// GlassEffect.kt:78-82
+double halcyonGlassHighlightAlpha({
+  required bool isLight,
+  required HalcyonGlassEffect glassEffect,
+}) => switch (glassEffect) {
+  HalcyonGlassEffect.blur => isLight ? 0.22 : 0.14,
+  HalcyonGlassEffect.liquidGlass => isLight ? 0.18 : 0.10,
+};
+
+/// GlassEffect.kt:84-86 —— **未做 gamma 校正**的线性加权，别换成 computeLuminance()
+double halcyonSimpleLuminance(Color color) =>
+    0.2126 * color.r + 0.7152 * color.g + 0.0722 * color.b;
diff --git a/lib/widgets/halcyon/glass_pill.dart b/lib/widgets/halcyon/glass_pill.dart
new file mode 100644
index 0000000..f3e2793
--- /dev/null
+++ b/lib/widgets/halcyon/glass_pill.dart
@@ -0,0 +1,143 @@
+// 源：halcyon/.../components/GlassPill.kt
+//
+// 原版 modifier 链（顺序即绘制顺序）：
+//   .clip(resolvedShape)
+//   .dropShadow(shape, Shadow(radius = 10.dp, alpha = if (isInDark) 0.2f else 0.1f))
+//   .then(drawBackdrop(
+//       effects = { blur(liquidBlurRadius); lens(refractionHeight, refractionAmount, chroma) },
+//       highlight = Highlight.Default.copy(alpha = bottomBarGlassHighlightAlpha(...)),
+//       onDrawSurface = { drawRect(containerColor) }))
+//
+// Flutter 对应：
+//   clip      -> ClipRRect
+//   dropShadow-> DecoratedBox(boxShadow)（画在裁剪层外）
+//   lens      -> HalcyonLens（盒子外扩 padding）
+//   highlight -> HalcyonHighlight（HighlightDrawing 的整块 shader 绘制）
+//   surface   -> ColoredBox(containerColor)
+//
+// 注意 lens 的盒子要比形状大 2×padding：BackdropFilter 只能取父级给它的盒子里
+// 的背景，不放大就采不到形状外的真实背景，边缘会是被裁出来的假边。
+import 'package:flutter/material.dart';
+
+import 'glass_effect.dart';
+import 'highlight.dart';
+import 'lens.dart';
+
+class HalcyonGlassPill extends StatelessWidget {
+  const HalcyonGlassPill({
+    super.key,
+    required this.cornerRadius,
+    required this.isLight,
+    required this.child,
+    this.glassEffect = HalcyonGlassEffect.liquidGlass,
+    this.liquidConfig = const HalcyonLiquidGlassConfig(),
+    this.disableRefraction = false,
+    this.surfaceColor,
+    this.highlightOverride,
+    this.shadowAlphaOverride,
+  });
+
+  final double cornerRadius;
+  final bool isLight;
+  final Widget child;
+  final HalcyonGlassEffect glassEffect;
+  final HalcyonLiquidGlassConfig liquidConfig;
+  final bool disableRefraction;
+
+  /// onDrawSurface 的底色；null → bottomBarGlassContainerColor（GlassPill.kt:38-45
+  /// 用 0.34/0.38 覆盖液态档默认值）
+  final Color? surfaceColor;
+
+  /// highlight 参数整份覆盖（底栏本体传 iosIndicatorSpecular.copy(alpha=0.75)、
+  /// pill 传 copy(alpha=pressProgress)，都不是默认档）
+  final Highlight? highlightOverride;
+
+  final double? shadowAlphaOverride;
+
+  @override
+  Widget build(BuildContext context) {
+    final bool isDark = !isLight;
+    final double radius = cornerRadius.clamp(0.0, 32.0);
+    final bool liquid = glassEffect == HalcyonGlassEffect.liquidGlass;
+
+    final Color surface =
+        surfaceColor ??
+        halcyonGlassContainerColor(
+          isLight: isLight,
+          glassEffect: glassEffect,
+          lightLiquidAlpha: 0.34, // GlassPill.kt:43
+          darkLiquidAlpha: 0.38, // GlassPill.kt:44
+        );
+
+    final double highlightAlpha = halcyonGlassHighlightAlpha(
+      isLight: isLight,
+      glassEffect: glassEffect,
+    );
+    final Highlight highlight =
+        highlightOverride ?? Highlight(alpha: highlightAlpha);
+
+    final double shadowAlpha =
+        shadowAlphaOverride ?? (isDark ? 0.20 : 0.10); // GlassPill.kt:83
+
+    return DecoratedBox(
+      decoration: BoxDecoration(
+        borderRadius: BorderRadius.circular(radius),
+        boxShadow: <BoxShadow>[
+          BoxShadow(
+            color: Colors.black.withValues(alpha: shadowAlpha),
+            blurRadius: 10,
+          ),
+        ],
+      ),
+      child: ClipRRect(
+        borderRadius: BorderRadius.circular(radius),
+        child: LayoutBuilder(
+          builder: (BuildContext context, BoxConstraints c) {
+            final double w = c.maxWidth;
+            final double h = c.maxHeight;
+            if (w <= 0 || h <= 0) return const SizedBox.shrink();
+            final bool useLens =
+                liquid &&
+                !disableRefraction &&
+                liquidConfig.refractionHeightDp > 0 &&
+                liquidConfig.refractionAmountDp > 0;
+            final double pad = useLens ? liquidConfig.refractionAmountDp : 0;
+            return Stack(
+              clipBehavior: Clip.none,
+              children: <Widget>[
+                if (useLens)
+                  Positioned(
+                    left: -pad,
+                    top: -pad,
+                    right: -pad,
+                    bottom: -pad,
+                    child: IgnorePointer(
+                      child: HalcyonLens(
+                        shapeSize: Size(w, h),
+                        radius: radius,
+                        refractionHeight: liquidConfig.refractionHeightDp,
+                        refractionAmount: liquidConfig.refractionAmountDp,
+                        chromaticAberration: liquidConfig.chromaticAberration,
+                      ),
+                    ),
+                  ),
+                Positioned.fill(
+                  child: IgnorePointer(child: ColoredBox(color: surface)),
+                ),
+                Positioned.fill(
+                  child: IgnorePointer(
+                    child: HalcyonHighlight(
+                      highlight: highlight,
+                      cornerRadius: radius,
+                    ),
+                  ),
+                ),
+                Positioned.fill(child: child),
+              ],
+            );
+          },
+        ),
+      ),
+    );
+  }
+}
diff --git a/lib/widgets/halcyon/highlight.dart b/lib/widgets/halcyon/highlight.dart
new file mode 100644
index 0000000..5e16065
--- /dev/null
+++ b/lib/widgets/halcyon/highlight.dart
@@ -0,0 +1,246 @@
+// 源：miuix-kmp · miuix-blur/.../highlight/
+//     Highlight.kt / HighlightStyle.kt / HighlightDrawing.kt
+//     （本地副本 ui-port/miuix-blur/highlight/）
+//
+// 1:1 对应：LightPosition / LightSource / BloomStroke / Highlight 四个数据类，
+// 六档预设，applyLightUniforms 的光向归一化与 axis fallback，drawHighlight 的
+// "整块区域画一遍 shader + 混合模式取自 style"。
+import 'dart:math' as math;
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+
+const String _kHighlightAsset = 'shaders/halcyon_highlight.frag';
+
+ui.FragmentProgram? _program;
+Future<void>? _loadFuture;
+
+Future<void> ensureHalcyonHighlight() => _loadFuture ??= _load();
+
+Future<void> _load() async {
+  try {
+    _program = await ui.FragmentProgram.fromAsset(_kHighlightAsset);
+  } catch (e) {
+    debugPrint('[halcyon-highlight] load failed: $e');
+  }
+}
+
+/// HighlightStyle.kt:29-30
+const double _lightRefX = 0.5;
+const double _lightRefY = 0.7;
+
+@immutable
+class LightPosition {
+  const LightPosition(this.x, this.y, this.z);
+  final double x, y, z;
+}
+
+@immutable
+class LightSource {
+  const LightSource({
+    required this.position,
+    this.intensity = 1.0,
+  });
+  final LightPosition position;
+  final double intensity;
+}
+
+@immutable
+class BloomStroke {
+  const BloomStroke({
+    this.color = const Color(0x0DFFFFFF), // White@0.05
+    this.blendMode = BlendMode.plus,
+    this.innerBlurRadius = 2.8,
+    this.primaryLight = const LightSource(
+      position: LightPosition(0.5, 0.5, -0.5),
+      intensity: 0.4,
+    ),
+    this.secondaryLight = const LightSource(
+      position: LightPosition(0.5, 0.8, -0.5),
+      intensity: 0.25,
+    ),
+  });
+
+  final Color color;
+  final BlendMode blendMode;
+  final double innerBlurRadius;
+  final LightSource primaryLight;
+  final LightSource secondaryLight;
+
+  /// HighlightStyle.kt:161-252 的六档预设（这里只保留 Default 用的中档与两档常用）
+  static const BloomStroke glassStrokeMiddleLight = BloomStroke();
+
+  static const BloomStroke glassStrokeMiddleDark = BloomStroke(
+    color: Color(0x0FFFFFFF), // White@0.06
+    innerBlurRadius: 2.0,
+    primaryLight: LightSource(
+      position: LightPosition(0.5, 0.5, -0.5),
+      intensity: 0.5,
+    ),
+    secondaryLight: LightSource(
+      position: LightPosition(0.5, 0.8, -0.5),
+      intensity: 0.25,
+    ),
+  );
+}
+
+@immutable
+class Highlight {
+  const Highlight({
+    this.width = 0.8,
+    this.alpha = 1.0,
+    this.style = BloomStroke.glassStrokeMiddleLight,
+  });
+
+  final double width;
+  final double alpha;
+  final BloomStroke style;
+
+  static const Highlight defaultHighlight = Highlight();
+
+  Highlight copyWith({double? width, double? alpha, BloomStroke? style}) =>
+      Highlight(
+        width: width ?? this.width,
+        alpha: alpha ?? this.alpha,
+        style: style ?? this.style,
+      );
+}
+
+/// HighlightDrawing.kt: drawHighlight —— 用 shader 铺满整个绘制区域。
+class HalcyonHighlight extends StatefulWidget {
+  const HalcyonHighlight({
+    super.key,
+    required this.highlight,
+    required this.cornerRadius,
+  });
+
+  final Highlight highlight;
+  final double cornerRadius;
+
+  @override
+  State<HalcyonHighlight> createState() => _HalcyonHighlightState();
+}
+
+class _HalcyonHighlightState extends State<HalcyonHighlight> {
+  ui.FragmentShader? _shader;
+
+  @override
+  void initState() {
+    super.initState();
+    ensureHalcyonHighlight().then((_) {
+      if (mounted) setState(() {});
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    // HighlightDrawing.kt:26-28 的守卫
+    if (widget.highlight.width <= 0 || widget.highlight.alpha <= 0) {
+      return const SizedBox.expand();
+    }
+    if (_program == null) return const SizedBox.expand();
+    _shader ??= _program!.fragmentShader();
+    return CustomPaint(
+      painter: _Painter(
+        shader: _shader!,
+        highlight: widget.highlight,
+        cornerRadius: widget.cornerRadius,
+        dpr: MediaQuery.devicePixelRatioOf(context),
+      ),
+      child: const SizedBox.expand(),
+    );
+  }
+}
+
+class _Painter extends CustomPainter {
+  _Painter({
+    required this.shader,
+    required this.highlight,
+    required this.cornerRadius,
+    required this.dpr,
+  });
+
+  final ui.FragmentShader shader;
+  final Highlight highlight;
+  final double cornerRadius;
+  final double dpr;
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    if (size.width <= 0 || size.height <= 0) return;
+    final BloomStroke style = highlight.style;
+    final double w = size.width * dpr;
+    final double h = size.height * dpr;
+    final double halfW = w * 0.5;
+    final double halfH = h * 0.5;
+    // HighlightDrawing.kt:33 描边宽度不超过短边一半
+    final double strokePx = (highlight.width * dpr).clamp(
+      0.0,
+      size.shortestSide * dpr / 2,
+    );
+    final double r = (cornerRadius * dpr).clamp(
+      0.0,
+      size.shortestSide * dpr / 2,
+    );
+    final double innerR = style.innerBlurRadius * dpr;
+
+    shader.setFloat(0, w);
+    shader.setFloat(1, h);
+    shader.setFloat(2, halfW);
+    shader.setFloat(3, halfH);
+    shader.setFloat(4, halfW.floorToDouble());
+    shader.setFloat(5, halfH.floorToDouble());
+    shader.setFloat(6, r);
+    shader.setFloat(7, r);
+    shader.setFloat(8, r);
+    shader.setFloat(9, r);
+    shader.setFloat(10, strokePx);
+    shader.setFloat(11, innerR);
+    shader.setFloat(12, innerR * innerR);
+    shader.setFloat(13, highlight.alpha);
+    shader.setFloat(14, style.color.a);
+    _applyLight(style.primaryLight, 15, 18, 23);
+    _applyLight(style.secondaryLight, 19, 22, 25);
+
+    canvas.drawRect(
+      Offset.zero & size,
+      Paint()
+        ..shader = shader
+        ..blendMode = style.blendMode,
+    );
+  }
+
+  /// HighlightStyle.kt:255-280 applyLightUniforms
+  void _applyLight(
+    LightSource light,
+    int dirBase,
+    int intensitySlot,
+    int axisBase,
+  ) {
+    final double dx = light.position.x - _lightRefX;
+    final double dy = light.position.y - _lightRefY;
+    final double dz = light.position.z;
+    final double len = math.max(math.sqrt(dx * dx + dy * dy + dz * dz), 1e-6);
+    final double nx = dx / len;
+    final double ny = dy / len;
+    shader.setFloat(dirBase, nx);
+    shader.setFloat(dirBase + 1, ny);
+    shader.setFloat(dirBase + 2, dz / len);
+    shader.setFloat(intensitySlot, light.intensity);
+    final double xyLen = math.sqrt(nx * nx + ny * ny);
+    if (xyLen > 1e-3) {
+      shader.setFloat(axisBase, nx / xyLen);
+      shader.setFloat(axisBase + 1, ny / xyLen);
+    } else {
+      // 光沿 Z 轴：回退到固定的上/下半轴（原版同款）
+      shader.setFloat(axisBase, 0.0);
+      shader.setFloat(axisBase + 1, dirBase == 19 ? 1.0 : -1.0);
+    }
+  }
+
+  @override
+  bool shouldRepaint(_Painter old) =>
+      old.highlight != highlight ||
+      old.cornerRadius != cornerRadius ||
+      old.dpr != dpr;
+}
diff --git a/lib/widgets/halcyon/lens.dart b/lib/widgets/halcyon/lens.dart
new file mode 100644
index 0000000..370f904
--- /dev/null
+++ b/lib/widgets/halcyon/lens.dart
@@ -0,0 +1,138 @@
+// 源：halcyon/.../components/liquid/Lens.kt
+//     `BackdropEffectScope.lens(refractionHeight, refractionAmount, depthEffect, chromaticAberration)`
+//
+// 1:1 对应关系：
+//   lens()                    -> HalcyonLens（本文件）
+//   padding < amount -> = amount  -> padding getter + 调用方按此摆盒子
+//   isRuntimeShaderSupported  -> ImageFilter.isShaderFilterSupported
+//   height<=0 || amount<=0 直接 return -> build 开头同位置守卫
+//   refractionAmount > 0 选色散变体 -> 同判据选 program
+//
+// 【槽 0-1 必须由 Dart 写】Flutter 不会给 shader filter 注入任何 uniform；
+// 项目内唯一跑通的 depth_parallax.frag 也是手动 setFloat(0,w)/setFloat(1,h)。
+// 这两个槽是纹理尺寸，留空 → uv = coord/0 → 采样全废（玻璃会变成纯色块）。
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+
+const String _kLensAsset = 'shaders/halcyon_lens.frag';
+const String _kLensDispersionAsset = 'shaders/halcyon_lens_dispersion.frag';
+
+ui.FragmentProgram? _plain;
+ui.FragmentProgram? _dispersion;
+Future<void>? _loadFuture;
+
+Future<void> ensureHalcyonLens() => _loadFuture ??= _load();
+
+Future<void> _load() async {
+  try {
+    _plain = await ui.FragmentProgram.fromAsset(_kLensAsset);
+  } catch (e) {
+    debugPrint('[halcyon-lens] plain load failed: $e');
+  }
+  try {
+    _dispersion = await ui.FragmentProgram.fromAsset(_kLensDispersionAsset);
+  } catch (e) {
+    debugPrint('[halcyon-lens] dispersion load failed: $e');
+  }
+}
+
+bool get halcyonLensSupported =>
+    ui.ImageFilter.isShaderFilterSupported && (_plain != null || _dispersion != null);
+
+class HalcyonLens extends StatefulWidget {
+  const HalcyonLens({
+    super.key,
+    required this.shapeSize,
+    required this.radius,
+    this.refractionHeight = 24.0,
+    this.refractionAmount = 24.0,
+    this.depthEffect = false,
+    this.chromaticAberration = 0.0,
+  });
+
+  /// 形状尺寸（逻辑 px，不含 padding）
+  final Size shapeSize;
+  final double radius;
+  final double refractionHeight;
+  final double refractionAmount;
+  final bool depthEffect;
+  final double chromaticAberration;
+
+  /// Lens.kt:32-34 `if (padding < refractionAmount) padding = refractionAmount`
+  double get padding => refractionAmount;
+
+  @override
+  State<HalcyonLens> createState() => _HalcyonLensState();
+}
+
+class _HalcyonLensState extends State<HalcyonLens> {
+  ui.FragmentShader? _shader;
+  bool _isDispersion = false;
+  bool _logged = false;
+
+  @override
+  void initState() {
+    super.initState();
+    ensureHalcyonLens().then((_) {
+      if (mounted) setState(() {});
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    // Lens.kt:29-30 的两条守卫，位置与原版一致
+    if (!ui.ImageFilter.isShaderFilterSupported) return const SizedBox.expand();
+    if (widget.refractionHeight <= 0 || widget.refractionAmount <= 0) {
+      return const SizedBox.expand();
+    }
+
+    final bool wantDispersion = widget.chromaticAberration > 0;
+    final ui.FragmentProgram? program = wantDispersion ? _dispersion : _plain;
+    if (!_logged) {
+      _logged = true;
+      debugPrint(
+        '[halcyon-lens] supported=${program != null} dispersion=$wantDispersion '
+        'shape=${widget.shapeSize} h=${widget.refractionHeight} a=${widget.refractionAmount}',
+      );
+    }
+    if (program == null) return const SizedBox.expand();
+    if (_shader == null || _isDispersion != wantDispersion) {
+      _shader = program.fragmentShader();
+      _isDispersion = wantDispersion;
+    }
+    final ui.FragmentShader shader = _shader!;
+    final double dpr = MediaQuery.devicePixelRatioOf(context);
+
+    return LayoutBuilder(
+      builder: (BuildContext context, BoxConstraints c) {
+        final double shapeW = widget.shapeSize.width * dpr;
+        final double shapeH = widget.shapeSize.height * dpr;
+        final double pad = widget.padding * dpr;
+        final double boxW = shapeW + pad * 2;
+        final double boxH = shapeH + pad * 2;
+        final double r = widget.radius * dpr;
+
+        shader.setFloat(0, boxW); // 纹理尺寸 —— 必须写
+        shader.setFloat(1, boxH);
+        shader.setFloat(2, shapeW);
+        shader.setFloat(3, shapeH);
+        shader.setFloat(4, -pad);
+        shader.setFloat(5, -pad);
+        shader.setFloat(6, r);
+        shader.setFloat(7, r);
+        shader.setFloat(8, r);
+        shader.setFloat(9, r);
+        shader.setFloat(10, widget.refractionHeight * dpr);
+        shader.setFloat(11, -widget.refractionAmount * dpr); // 负值 = 向内
+        shader.setFloat(12, widget.depthEffect ? 1.0 : 0.0);
+        if (wantDispersion) shader.setFloat(13, widget.chromaticAberration);
+
+        return BackdropFilter(
+          filter: ui.ImageFilter.shader(shader),
+          child: const SizedBox.expand(),
+        );
+      },
+    );
+  }
+}
diff --git a/lib/widgets/halcyon_glass.dart b/lib/widgets/halcyon_glass.dart
new file mode 100644
index 0000000..80a113e
--- /dev/null
+++ b/lib/widgets/halcyon_glass.dart
@@ -0,0 +1,311 @@
+/// Halcyon 风格毛玻璃容器（液态玻璃/高斯模糊/磨砂底）。
+///
+/// 视觉规范逐项取自 Halcyon（Kifranei/Halcyon）的底栏玻璃体系
+/// `ui/components/GlassEffect.kt`：
+///  - 磨砂底色：亮色 White@0.38 / 暗色 #111114@0.42（LiquidGlass 档）
+///  - 内缘高光：亮色 alpha 0.18 / 暗色 alpha 0.10（玻璃上沿反光）
+///  - 模糊：高斯 sigma 默认 18（Halcyon 的 blurRadiusDp=6 是 RenderEffect
+///    的半径口径，与 Flutter ImageFilter.blur 的 sigma 不是一个量纲；18 在
+///    Flutter 侧的观感与其 6dp 接近，可后续按真机微调）
+///  - 「液态玻璃」的边缘折射：Flutter 无 Miuix lens 着色器，这里用
+///    **上缘高光渐变 + 内描边**近似（顶部亮、往下衰减 + 1px 内描边，
+///    观感接近 iOS 液态玻璃的边缘反光）
+///
+/// 设计目标：**自包含**（只依赖 Flutter SDK 的 widgets/dart:ui），上游
+/// md3Music 任何文件都不 import 它，只有我们钩子处的 2~3 行引用——上游
+/// 更新时补丁冲突面最小。
+import 'dart:ui' show ImageFilter;
+
+import 'package:flutter/material.dart';
+import 'package:provider/provider.dart';
+
+import '../providers/theme_provider.dart';
+
+/// 背景图模式下的**全局卡片玻璃**分档透明度（app.dart 的
+/// `_applyBackgroundOverrides` 按档注入 colorScheme.surfaceContainer 族）。
+///
+/// 为什么是主题层而不是逐卡 BackdropFilter：壁纸已由 AppBackground 全局
+/// 预模糊（ImageFiltered），半透明卡片透出的就是毛玻璃背景——列表里几十
+/// 张卡都套 BackdropFilter 的开销不可接受，纯色 alpha 则零开销。
+/// 分档沿用 M3 surface 族语义：越浮起（High/Highest）越实，保证弹层、
+/// 菜单等悬浮件的可读性；对齐 Halcyon `frostedCardColor` 的 defaultAlpha
+/// 0.42 量级（中间档 0.52），真机观感可整组微调。
+const double kHalcyonGlassSurfaceLowestAlpha = 0.40;
+const double kHalcyonGlassSurfaceLowAlpha = 0.46;
+const double kHalcyonGlassSurfaceAlpha = 0.52;
+const double kHalcyonGlassSurfaceHighAlpha = 0.58;
+const double kHalcyonGlassSurfaceHighestAlpha = 0.66;
+
+/// 底栏「滚动隐藏」总开关：主页面列表下滑浏览（手指上滑）时玻璃底栏下沉
+/// 让位内容，下滑回看时升起（Halcyon / YouTube Music 同款行为）。
+/// false 时恢复上游行为（底栏常驻，仅二级页面 route 驱动收起）。
+const bool kHalcyonScrollHideChrome = true;
+
+/// 背景图模式开启才渲染玻璃效果；关闭时原样返回 [child]（零痕迹）。
+///
+/// 玻璃的本质是「透出预模糊壁纸」——壁纸不存在时玻璃只剩一层怪异的
+/// 半透明色斑，因此以背景图开关作为总闸，调用方无需各自判断。
+bool halcyonGlassEnabled(BuildContext context) =>
+    context.watch<ThemeProvider>().useBackgroundImage;
+
+/// 玻璃档位：磨砂（毛玻璃）/ 液态玻璃（磨砂 + 更强边缘反光）。
+enum HalcyonGlassStyle { frosted, liquid }
+
+class HalcyonGlassContainer extends StatelessWidget {
+  const HalcyonGlassContainer({
+    super.key,
+    required this.child,
+    this.borderRadius = BorderRadius.zero,
+    this.blurSigma = 18.0,
+    this.style = HalcyonGlassStyle.liquid,
+    this.fallbackColor,
+    this.padding,
+  });
+
+  final Widget child;
+  final BorderRadius borderRadius;
+
+  /// 高斯模糊 sigma（BackdropFilter/ImageFilter.blur）。
+  final double blurSigma;
+
+  final HalcyonGlassStyle style;
+
+  /// BackdropFilter 在部分低端机/旧 WebView 场景可能被禁用（EngineFlags），
+  /// 届时退化为纯色容器，保证可用性。
+  final Color? fallbackColor;
+
+  final EdgeInsetsGeometry? padding;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final isDark = theme.brightness == Brightness.dark;
+    // Halcyon GlassEffect.kt bottomBarGlassContainerColor：
+    // LiquidGlass 档 亮 0.38 / 暗 0.42；底色亮白 / 暗 #111114。
+    final tint = isDark
+        ? const Color(0xFF111114).withValues(alpha: 0.42)
+        : Colors.white.withValues(alpha: 0.38);
+    // bottomBarGlassHighlightAlpha：LiquidGlass 档 亮 0.18 / 暗 0.10。
+    final highlightAlpha = isDark ? 0.10 : 0.18;
+    final effectiveTint = fallbackColor ?? tint;
+
+    // 高光渐变：顶部最强、快速衰减到底部（玻璃上缘反光）。liquid 档更亮。
+    // 注意：BoxDecoration 的 color 与 gradient 互斥（assert），因此高光
+    // 不走第二层，而是把顶部颜色往白色插值 highlightAlpha 后做成两段
+    // gradient —— 顶部=带高光的 tint，底部=纯 tint。
+    final Widget content = Padding(
+      padding: padding ?? EdgeInsets.zero,
+      child: child,
+    );
+
+    // 顶部色 = tint 向白混合 highlightAlpha（模拟玻璃上缘反光叠在底色上）
+    final topColor =
+        Color.lerp(effectiveTint, Colors.white, highlightAlpha)!;
+    final bottomColor = effectiveTint;
+
+    return ClipRRect(
+      borderRadius: borderRadius,
+      // 描边画在模糊层之上：DecoratedBox(foreground) 顺序 = blur → tint → stroke
+      child: BackdropFilter(
+        filter: ImageFilter.blur(
+          sigmaX: blurSigma,
+          sigmaY: blurSigma,
+          tileMode: TileMode.mirror,
+        ),
+        child: Container(
+          decoration: BoxDecoration(
+            borderRadius: borderRadius,
+            // 液态玻璃：顶部高光渐变（融合进 tint），frosted 档无渐变纯 tint。
+            gradient: style == HalcyonGlassStyle.liquid
+                ? LinearGradient(
+                    begin: Alignment.topCenter,
+                    end: Alignment.center,
+                    colors: [topColor, bottomColor],
+                    stops: const [0.0, 1.0],
+                  )
+                : null,
+            color: style == HalcyonGlassStyle.liquid ? null : effectiveTint,
+            border: Border.all(
+              color: Colors.white.withValues(
+                alpha: style == HalcyonGlassStyle.liquid
+                    ? highlightAlpha * 0.9
+                    : highlightAlpha * 0.5,
+              ),
+              width: 1.0,
+            ),
+          ),
+          child: content,
+        ),
+      ),
+    );
+  }
+}
+
+/// Halcyon 仪表盘 tile 同构的**真模糊玻璃卡**（对应 Halcyon
+/// `frostedCardModifier`：Miuix textureBlur 72f/64f + 模糊开启时卡体
+/// Color.Transparent）。与 [HalcyonGlassContainer] 的区别：卡片档 tint
+/// 更淡（模糊感为主）、自带 [footer] 副文本底衬槽。
+///
+/// [footer] 是 Halcyon tile 的「文字底模糊底层效果」：副文本所在的一条
+/// 独立横带，比卡体更亮、更糊（内部再叠一层 BackdropFilter 与卡体模糊
+/// 累加），上缘一条内缘高光分隔线。结构与截图 tile 一致：标题内容在
+/// 卡体，副文本落在 footer 带。
+///
+/// 适用场景：屏幕上数量有限的大卡（入口 tile / 概览卡）。长列表行卡请
+/// 走主题层的全局半透明（见 kHalcyonGlassSurface*Alpha），不要逐行套
+/// BackdropFilter。
+class HalcyonGlassCard extends StatelessWidget {
+  const HalcyonGlassCard({
+    super.key,
+    required this.child,
+    this.footer,
+    this.borderRadius = const BorderRadius.all(Radius.circular(16)),
+    this.blurSigma = 30.0,
+    this.padding = const EdgeInsets.all(16),
+    this.footerPadding = const EdgeInsets.symmetric(
+      horizontal: 16,
+      vertical: 10,
+    ),
+  });
+
+  final Widget child;
+
+  /// 底部副文本槽：自动获得「更亮更糊」的底衬条。
+  final Widget? footer;
+
+  final BorderRadius borderRadius;
+
+  /// 卡体模糊 sigma。Halcyon 卡片档 textureBlur 72f（暗）观感比底栏
+  /// （6dp/18sigma）强得多，Flutter 侧取 30 起步，真机微调。
+  final double blurSigma;
+
+  final EdgeInsetsGeometry padding;
+  final EdgeInsetsGeometry footerPadding;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final isDark = theme.brightness == Brightness.dark;
+    // 卡片档 tint：Halcyon 模糊开启时卡体全透（靠 blend 混色），Flutter
+    // 无对应混合着色器，用淡 tint 保底色相；比底栏档（0.42）更透。
+    final tint = isDark
+        ? const Color(0xFF111114).withValues(alpha: 0.30)
+        : Colors.white.withValues(alpha: 0.30);
+    // footer 比 card 体更亮：暗色往白提（发白磨砂带），亮色往白再提一点。
+    final footerTint = isDark
+        ? const Color(0xFF111114).withValues(alpha: 0.30 + 0.10)
+        : Colors.white.withValues(alpha: 0.30 + 0.14);
+    final highlightAlpha = isDark ? 0.10 : 0.18;
+
+    return ClipRRect(
+      borderRadius: borderRadius,
+      child: BackdropFilter(
+        filter: ImageFilter.blur(
+          sigmaX: blurSigma,
+          sigmaY: blurSigma,
+          tileMode: TileMode.mirror,
+        ),
+        child: Container(
+          decoration: BoxDecoration(
+            borderRadius: borderRadius,
+            border: Border.all(
+              color: Colors.white.withValues(alpha: highlightAlpha * 0.9),
+              width: 1.0,
+            ),
+          ),
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              // 卡体：顶部高光渐变（同 HalcyonGlassContainer 的 liquid 观感）
+              Container(
+                decoration: BoxDecoration(
+                  gradient: LinearGradient(
+                    begin: Alignment.topCenter,
+                    end: Alignment.center,
+                    colors: [
+                      Color.lerp(tint, Colors.white, highlightAlpha)!,
+                      tint,
+                    ],
+                  ),
+                ),
+                padding: padding,
+                child: child,
+              ),
+              if (footer != null)
+                // footer 底衬：更亮 tint + 再叠一层模糊（与卡体累加 → 更糊）
+                Container(
+                  decoration: BoxDecoration(
+                    color: footerTint,
+                    border: Border(
+                      top: BorderSide(
+                        color: Colors.white.withValues(
+                          alpha: highlightAlpha * 0.9,
+                        ),
+                        width: 1.0,
+                      ),
+                    ),
+                  ),
+                  child: BackdropFilter(
+                    filter: ImageFilter.blur(
+                      sigmaX: blurSigma * 1.3,
+                      sigmaY: blurSigma * 1.3,
+                      tileMode: TileMode.mirror,
+                    ),
+                    child: Padding(
+                      padding: footerPadding,
+                      child: footer!,
+                    ),
+                  ),
+                ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// 独立的「文字底模糊底层」横带：可单独套在任意卡片内副文本（hint/
+/// summary）的下面，不需要整卡换成 [HalcyonGlassCard]。
+///
+/// 关闭背景图模式时直接返回 [child]（halcyonGlassEnabled 总闸）。
+/// 底衬材质：暗色白纱 / 亮色白提亮，自带水平内边距归零（由调用方控制
+/// 外形，条带本身铺满父级给的宽度）。
+class HalcyonGlassFooterStrip extends StatelessWidget {
+  const HalcyonGlassFooterStrip({
+    super.key,
+    required this.child,
+    this.padding = const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
+    this.borderRadius,
+  });
+
+  final Widget child;
+  final EdgeInsetsGeometry padding;
+  final BorderRadius? borderRadius;
+
+  @override
+  Widget build(BuildContext context) {
+    if (!halcyonGlassEnabled(context)) return child;
+    final isDark = Theme.of(context).brightness == Brightness.dark;
+    final tint = isDark
+        ? Colors.white.withValues(alpha: 0.10)
+        : Colors.white.withValues(alpha: 0.35);
+    final result = Container(
+      decoration: BoxDecoration(
+        color: tint,
+        borderRadius: borderRadius,
+      ),
+      child: BackdropFilter(
+        filter: ImageFilter.blur(
+          sigmaX: 24,
+          sigmaY: 24,
+          tileMode: TileMode.mirror,
+        ),
+        child: Padding(padding: padding, child: child),
+      ),
+    );
+    if (borderRadius == null) return result;
+    return ClipRRect(borderRadius: borderRadius!, child: result);
+  }
+}
