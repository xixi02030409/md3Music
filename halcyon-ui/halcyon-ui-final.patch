+dependency_overrides:
+  # 钉住 material_ui 1.7.0：1.8.0 新导出 RoundedPolygon/CornerRounding（src/shapes/），
+  # 与 m3e_core 1.1.4 自带的同名符号冲突，同时使用会出现
