index 0000000..ab2e13c
--- /dev/null
+++ b/lib/widgets/halcyon/lens.dart
@@ -0,0 +1,155 @@
+// Halcyon Lens.kt 的 Flutter 等价物 —— **结构、签名、守卫位置逐条对齐**。
+//
+// 源：ui-port/halcyon/.../ui/components/liquid/Lens.kt
+//     （adapted from Kyant0/AndroidLiquidGlass, Apache-2.0）
+//
+// 原版是 `BackdropEffectScope.lens(refractionHeight, refractionAmount,
+// depthEffect, chromaticAberration)`：往 drawBackdrop 的 effect 链里挂一个
+// RuntimeShader，并按 `padding < refractionAmount → padding = refractionAmount`
+// 扩大 backdrop 采样区（否则边缘折射会采样越界、出现拖影）。
+//
+// Flutter 的 BackdropFilter 只能覆盖「父级给它的盒子」，所以这里把同一个语义
+// 表达成：**滤镜盒子 = 形状尺寸 + 2×padding**，再用 offset(=-padding) 把纹理
+// 坐标平移回形状原点，形状本身由调用方在外面裁（ClipRRect）。
+//
+// 两个 SkSL 变体分别落在两个 .frag 文件里，按 `chromaticAberration > 0` 选，
+// 与原版 Lens.kt:38-45 的判据一致 —— 不用一个 shader 加分支糊过去。
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+
+const String kHalcyonLensAsset = 'shaders/halcyon_lens.frag';
+const String kHalcyonLensDispersionAsset = 'shaders/halcyon_lens_dispersion.frag';
+
+ui.FragmentProgram? _lensProgram;
+ui.FragmentProgram? _dispersionProgram;
+Future<void>? _loadFuture;
+
+/// 预热两个变体（幂等、共享同一个 Future，避免第二个持有者拿到空 program）。
+Future<void> ensureHalcyonLensShaders() => _loadFuture ??= _load();
+
+Future<void> _load() async {
+  try {
+    _lensProgram = await ui.FragmentProgram.fromAsset(kHalcyonLensAsset);
+  } catch (_) {
+    _lensProgram = null;
+  }
+  try {
+    _dispersionProgram = await ui.FragmentProgram.fromAsset(
+      kHalcyonLensDispersionAsset,
+    );
+  } catch (_) {
+    _dispersionProgram = null;
+  }
+}
+
+/// 当前是否具备真折射能力（Impeller + 至少一个变体加载成功）。
+bool get halcyonLensSupported =>
+    ui.ImageFilter.isShaderFilterSupported &&
+    (_lensProgram != null || _dispersionProgram != null);
+
+/// 折射镜片（对应 Lens.kt 的 `lens()`）。
+///
+/// 尺寸约定：本 widget 的盒子 = **形状 + 2×padding**；[shapeSize] 是该形状
+/// 自己的尺寸。调用方负责把本 widget 相对形状外扩 [padding] 摆放，并在外层
+/// 用形状裁剪 —— 这正是原版 `BackdropEffectScope.padding` 的几何含义。
+class HalcyonLens extends StatefulWidget {
+  const HalcyonLens({
+    super.key,
+    required this.shapeSize,
+    required this.cornerRadii,
+    required this.refractionHeight,
+    required this.refractionAmount,
+    this.depthEffect = false,
+    this.chromaticAberration = 0,
+  });
+
+  /// 形状尺寸（逻辑 px，不含 padding）。
+  final Size shapeSize;
+
+  /// 四角半径（逻辑 px，顺序 TL/TR/BR/BL）。
+  final Radius cornerRadii;
+
+  /// 折射带高度（逻辑 px）。
+  final double refractionHeight;
+
+  /// 折射位移（逻辑 px，**正值**；内部按原版取负）。
+  final double refractionAmount;
+
+  final bool depthEffect;
+
+  /// 色散强度；> 0 才走 7 通道色散变体（原版同一判据）。
+  final double chromaticAberration;
+
+  /// 原版 `if (padding < refractionAmount) padding = refractionAmount`。
+  double get padding => refractionAmount;
+
+  @override
+  State<HalcyonLens> createState() => _HalcyonLensState();
+}
+
+class _HalcyonLensState extends State<HalcyonLens> {
+  ui.FragmentShader? _shader;
+  bool _builtDispersion = false;
+
+  @override
+  void initState() {
+    super.initState();
+    ensureHalcyonLensShaders().then((_) {
+      if (mounted) setState(() {});
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    // Lens.kt:29-30 的两条守卫，位置与原版一致（在拿到 shader 之前就返回）
+    if (!ui.ImageFilter.isShaderFilterSupported) {
+      return const SizedBox.expand();
+    }
+    if (widget.refractionHeight <= 0 || widget.refractionAmount <= 0) {
+      return const SizedBox.expand();
+    }
+    final bool dispersion = widget.chromaticAberration > 0;
+    final ui.FragmentProgram? program = dispersion
+        ? _dispersionProgram
+        : _lensProgram;
+    if (program == null) {
+      return const SizedBox.expand();
+    }
+    // 变体切换时换实例（同一 program 的 shader 才能复用）
+    if (_shader == null || _builtDispersion != dispersion) {
+      _shader = program.fragmentShader();
+      _builtDispersion = dispersion;
+    }
+    final ui.FragmentShader shader = _shader!;
+    final double dpr = MediaQuery.devicePixelRatioOf(context);
+    return LayoutBuilder(
+      builder: (BuildContext context, BoxConstraints c) {
+        final double shapeW = widget.shapeSize.width * dpr;
+        final double shapeH = widget.shapeSize.height * dpr;
+        final double pad = widget.padding * dpr;
+        // 槽 0-1 = u_texSize（引擎注入），从 2 开始写。
+        shader.setFloat(2, shapeW);
+        shader.setFloat(3, shapeH);
+        shader.setFloat(4, -pad);
+        shader.setFloat(5, -pad);
+        final double r = widget.cornerRadii.x * dpr;
+        shader.setFloat(6, r);
+        shader.setFloat(7, r);
+        shader.setFloat(8, r);
+        shader.setFloat(9, r);
+        shader.setFloat(10, widget.refractionHeight * dpr);
+        // 原版 setFloatUniform("refractionAmount", -scaledRefractionAmount)
+        shader.setFloat(11, -widget.refractionAmount * dpr);
+        shader.setFloat(12, widget.depthEffect ? 1.0 : 0.0);
+        if (dispersion) {
+          shader.setFloat(13, widget.chromaticAberration);
+        }
+        return BackdropFilter(
+          filter: ui.ImageFilter.shader(shader),
+          child: const SizedBox.expand(),
+        );
+      },
+    );
+  }
+}
diff --git a/lib/widgets/halcyon_dock_bar.dart b/lib/widgets/halcyon_dock_bar.dart
new file mode 100644
index 0000000..fda4083
--- /dev/null
+++ b/lib/widgets/halcyon_dock_bar.dart
@@ -0,0 +1,434 @@
+// Halcyon 液态玻璃悬浮底栏（Flutter 移植版）。
+// 蓝本：Halcyon (Kotlin Compose) ui/components/FloatingBottomBar.kt +
+// ui/animation/DampedDragAnimation.kt 的可见行为子集（行号见注释）：
+//   - 整面液态玻璃：整个面板就是一块 HalcyonGlassPill（真折射 + 色散 +
+//     双光源高光，Kyant0 Lens 同款），背景图直接透过玻璃清晰可见——
+//     用户裁定：不做磨砂底板，模糊是画蛇添足，折射要的就是清晰底图。
+//   - 玻璃 tint：LiquidGlass 档 0.34/0.38（GlassPill.kt:38-45），只负责
+//     压暗保证图标可读，不遮底图。
+//   - BloomStroke 双光源渐变高光（同上 161-179 白 0.12）。
+//   - pill 指示器：primary 15% 实底（FloatingBottomBar.kt:569 accent 0.15），
+//     拖动跟手、松手 spring 回弹（同文件 328：dampingRatio 1 / stiffness 300）。
+//   - 拖动滑切：手指横向拖动连续扫过 tab（DampedDragAnimation 语义），
+//     位移超 touchSlop 且落点 tab 变化才提交切换（同文件 322）。
+//   - 橡皮筋：拖动面板整体位移 ≤4dp EaseOut（同文件 279-289、345）。
+//   - 按压形变：面板 scale 1→1+16dp/width（同文件 444）、pill 速度拉伸
+//     （同文件 537-539：横向 /(1-0.75v)、纵向 ×(1-0.25v)，clamp ±0.2）。
+// 与 MD3Music 的融合边界：导航提交/震动/TV 焦点包装/labelBehavior 三档
+// 由调用方（responsive_layout）注入，本组件只管视觉与手势。
+import 'dart:math' as math;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/physics.dart' show SpringDescription, SpringSimulation;
+
+import 'halcyon/glass_pill.dart';
+import 'halcyon/lens.dart';
+
+/// 底栏玻璃 tint（GlassPill.kt:38-45 LiquidGlass 档原值）。用户实测裁定：
+/// 底栏必须透出背景图（暗玻璃而非磨砂），整体 blur 属于画蛇添足——
+/// 折射镜片要的正是清晰的底图细节。勿再调回重档。
+const double kHalcyonDockLightAlpha = 0.34;
+const double kHalcyonDockDarkAlpha = 0.38;
+const Color kHalcyonDockDarkTint = Color(0xFF111114);
+
+/// pill 指示器底色 alpha（FloatingBottomBar.kt:569 accent 0.15）。
+const double kHalcyonDockPillAlpha = 0.15;
+
+/// 橡皮筋最大位移（同上 279 rubberBandPx = 4.dp）。
+const double kHalcyonDockRubberBandDp = 4.0;
+
+/// 按压时面板膨胀的等效值（同上 444：1 + 16.dp/width）。
+const double kHalcyonDockPressBulgeDp = 16.0;
+
+/// pill/面板回弹弹簧（同上 328 spring(1f, 300f, 0.5f)）。
+const double kHalcyonDockSpringDampingRatio = 1.0;
+const double kHalcyonDockSpringStiffness = 300.0;
+
+/// pill 高 56 = 面板 64 - 上下 4 padding（同上 465-466、502）。
+const double kHalcyonDockPanelHeightDp = 64.0;
+const double kHalcyonDockEdgeInsetDp = 4.0;
+
+double _easeOut(double t) {
+  final double c = t.clamp(0.0, 1.0);
+  return 1.0 - (1.0 - c) * (1.0 - c);
+}
+
+/// 标签显隐三档（对应 MD3 NavigationDestinationLabelBehavior）。
+enum HalcyonDockLabelMode { none, activeOnly, always }
+
+/// Halcyon 风格悬浮液态玻璃底栏：整面折射镜片 + 拖动滑切 + pill 指示器。
+///
+/// [itemBuilder] 返回每个 tab 的内容（图标/文字由调用方组装，便于挂
+/// TV 焦点包装与 _CapsuleBounce 回弹）；[onItemTap] 在点击/拖动提交时
+/// 回调目标 index。
+class HalcyonDockBar extends StatefulWidget {
+  const HalcyonDockBar({
+    super.key,
+    required this.selectedIndex,
+    required this.tabCount,
+    required this.itemBuilder,
+    required this.onItemTap,
+    this.height = kHalcyonDockPanelHeightDp,
+    this.labelMode = HalcyonDockLabelMode.none,
+  });
+
+  final int selectedIndex;
+  final int tabCount;
+  final double height;
+  final HalcyonDockLabelMode labelMode;
+
+  /// (context, index, selected) → tab 内容。
+  final Widget Function(BuildContext, int, bool) itemBuilder;
+
+  /// 点击/拖动提交切换（与当前 index 相同不回调，由本组件保证）。
+  final ValueChanged<int> onItemTap;
+
+  @override
+  State<HalcyonDockBar> createState() => HalcyonDockBarState();
+}
+
+class HalcyonDockBarState extends State<HalcyonDockBar>
+    with TickerProviderStateMixin {
+  /// pill 连续位置（0..tabCount-1 浮点）。
+  double _pillValue = 0;
+
+  /// 拖动速度 px/s（pill 速度形变用，FloatingBottomBar.kt:537）。
+  double _velocity = 0;
+
+  /// 橡皮筋积分位移 px（同上 345 snapTo(value + dx)）。
+  double _rubberOffset = 0;
+
+  /// 按压进度 0..1（拖动中 1，松手回落）。
+  double _press = 0;
+
+  bool _dragging = false;
+  double _dragTravel = 0;
+  Duration _lastMoveTime = Duration.zero;
+  double _lastMoveX = 0;
+
+  double _totalWidth = 0;
+  double _tabWidth = 1;
+
+  /// 松手/点击后 pill 的 spring 回弹。
+  late final AnimationController _pillSpring = AnimationController(
+    vsync: this,
+    duration: const Duration(seconds: 1),
+  );
+
+  @override
+  void initState() {
+    super.initState();
+    _pillValue = widget.selectedIndex.toDouble();
+  }
+
+  @override
+  void didUpdateWidget(covariant HalcyonDockBar old) {
+    super.didUpdateWidget(old);
+    // 外部 route 变化（返回键/深链）时 pill spring 跟随。
+    if (old.selectedIndex != widget.selectedIndex && !_dragging) {
+      _springPillTo(widget.selectedIndex.toDouble());
+    }
+  }
+
+  @override
+  void dispose() {
+    _pillSpring.dispose();
+    super.dispose();
+  }
+
+  SpringDescription get _springDesc => SpringDescription(
+    mass: 1,
+    stiffness: kHalcyonDockSpringStiffness,
+    // damping = ratio × 2 × √(mass×stiffness)，ratio=1 无弹跳。
+    damping:
+        kHalcyonDockSpringDampingRatio *
+        2 *
+        math.sqrt(kHalcyonDockSpringStiffness),
+  );
+
+  void _springPillTo(double target) {
+    _pillSpring.animateWith(
+      SpringSimulation(_springDesc, _pillValue, target, 0),
+    );
+  }
+
+  void _onDragStart(DragStartDetails d) {
+    _dragging = true;
+    _dragTravel = 0;
+    _lastMoveTime = d.sourceTimeStamp ?? Duration.zero;
+    _lastMoveX = d.localPosition.dx;
+    _pillSpring.stop();
+    setState(() => _press = 1);
+  }
+
+  void _onDragUpdate(DragUpdateDetails d) {
+    if (!_dragging || _tabWidth <= 0) return;
+    final double x = d.localPosition.dx;
+    _dragTravel += d.delta.dx.abs();
+    // pill 连续跟手（同上 340：delta/tabWidth 按位置直读）。
+    _pillValue = ((x - kHalcyonDockEdgeInsetDp) / _tabWidth).clamp(
+      0.0,
+      (widget.tabCount - 1).toDouble(),
+    );
+    // 速度估计 px/s（pill 速度形变，同上 537）。
+    final double dtMs = ((d.sourceTimeStamp ?? Duration.zero) - _lastMoveTime)
+        .inMilliseconds
+        .toDouble();
+    if (dtMs > 1) {
+      _velocity = ((x - _lastMoveX) / dtMs * 1000).clamp(-4000.0, 4000.0);
+      _lastMoveTime = d.sourceTimeStamp ?? Duration.zero;
+      _lastMoveX = x;
+    }
+    // 橡皮筋积分（同上 345）。
+    _rubberOffset += d.delta.dx;
+    setState(() {});
+  }
+
+  void _onDragEnd(DragEndDetails d) {
+    if (!_dragging) return;
+    _dragging = false;
+    _velocity = d.velocity.pixelsPerSecond.dx.clamp(-4000.0, 4000.0);
+    // 提交判定（同上 322）：位移超 touchSlop 且 round 后变 tab 才切。
+    final double slop = MediaQuery.gestureSettingsOf(context).touchSlop ?? 18.0;
+    final int target = _pillValue.round().clamp(0, widget.tabCount - 1);
+    if (_dragTravel.abs() >= slop && target != widget.selectedIndex) {
+      widget.onItemTap(target);
+    }
+    _springPillTo(widget.selectedIndex.toDouble());
+    setState(() => _press = 0);
+    // 速度形变随后续 spring 帧自然衰减（见 build 中每帧 ×0.86）。
+  }
+
+  void _onDragCancel() {
+    if (!_dragging) return;
+    _dragging = false;
+    _springPillTo(widget.selectedIndex.toDouble());
+    setState(() => _press = 0);
+  }
+
+  void _tapItem(int index) {
+    if (index == widget.selectedIndex) return;
+    _velocity = 0;
+    widget.onItemTap(index);
+    _springPillTo(index.toDouble());
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final ColorScheme cs = Theme.of(context).colorScheme;
+    final bool isDark = Theme.of(context).brightness == Brightness.dark;
+    final Color panelColor = (isDark ? kHalcyonDockDarkTint : Colors.white)
+        .withValues(
+          alpha: isDark ? kHalcyonDockDarkAlpha : kHalcyonDockLightAlpha,
+        );
+    final Color activeColor = cs.primary;
+
+    return LayoutBuilder(
+      builder: (BuildContext context, BoxConstraints c) {
+        _totalWidth = c.maxWidth;
+        _tabWidth =
+            ((_totalWidth - kHalcyonDockEdgeInsetDp * 2) / widget.tabCount)
+                .clamp(1.0, double.infinity);
+        final double radius = widget.height / 2;
+        final double press = _press;
+        final double pillLeft =
+            kHalcyonDockEdgeInsetDp + _pillValue * _tabWidth;
+        // 速度形变（同上 537-539）：v = velocity/10，clamp ±0.2（归一化口径
+        // 与 Compose 的 px 值不同：这里 /1000 折算 dp 量级，实测再调）。
+        final double v = (_velocity / 10 / 1000).clamp(-0.2, 0.2);
+        final double pillScaleX = 1.0 / (1.0 - (v * 0.75));
+        final double pillScaleY = 1.0 - (v * 0.25);
+        // 橡皮筋（同上 285-287）：fraction×4dp×EaseOut(|fraction|)。
+        final double f = (_rubberOffset / math.max(_totalWidth, 1)).clamp(
+          -1.0,
+          1.0,
+        );
+        final double panelShift =
+            kHalcyonDockRubberBandDp * f.sign * _easeOut(f.abs());
+        // 面板按压膨胀（同上 444：lerp(1, 1+16dp/width, press)）。
+        final double bulge =
+            1.0 + kHalcyonDockPressBulgeDp / math.max(_totalWidth, 1) * press;
+
+        return GestureDetector(
+          behavior: HitTestBehavior.deferToChild,
+          onHorizontalDragStart: _onDragStart,
+          onHorizontalDragUpdate: _onDragUpdate,
+          onHorizontalDragEnd: _onDragEnd,
+          onHorizontalDragCancel: _onDragCancel,
+          child: Transform.translate(
+            offset: Offset(panelShift, 0),
+            child: Transform.scale(
+              scale: bulge,
+              // 【Halcyon 玻璃】整块面板交给 HalcyonGlassPill（GlassPill.kt 的
+              // 逐条移植件：clip → dropShadow → blur → lens → surface → highlight）。
+              // 这里不再自己拼镜片/tint/高光层 —— 层叠顺序属于组件的事，
+              // 散在调用方拼必然各处不一致。
+              child: SizedBox(
+                height: widget.height,
+                child: HalcyonGlassPill(
+                  cornerRadius: radius,
+                  isLight: !isDark,
+                  surfaceColor: panelColor,
+                  child: Stack(
+                    children: <Widget>[
+                      // pill 选中指示器 —— **FloatingBottomBar.kt:510-560 原样**：
+                        //    它不是一块纯色，静止时只是 0.1 的黑/白面（亮=黑、暗=白），
+                        //    按住时整块**变成另一枚小透镜**：
+                        //      lens(refractionHeight = 10dp·p, refractionAmount = 14dp·p,
+                        //           depthEffect = true, chromaticAberration = 0.5)
+                        //    同时面板色淡出到 0、叠 0.03 黑，并挂 8dp 内阴影。
+                        //    旧实现只画 accent@0.15 纯色 —— 按下去毫无玻璃感，正是
+                        //    "只有一层贴纸"的观感来源。
+                        Positioned(
+                          left: pillLeft,
+                          top: 4,
+                          bottom: 4,
+                          width: _tabWidth,
+                          child: Transform.scale(
+                            scaleX: pillScaleX,
+                            scaleY: pillScaleY,
+                            alignment: Alignment.center,
+                            child: ClipRRect(
+                              borderRadius: BorderRadius.circular(radius - 4),
+                              child: LayoutBuilder(
+                                builder: (BuildContext ctx, BoxConstraints pc) {
+                                  // 镜片盒子要比 pill 大 2×padding（Lens.kt 的
+                                  // BackdropEffectScope.padding 语义），所以
+                                  // Stack 不能裁、由外层 ClipRRect 裁形状。
+                                  final double pad = 14.0 * press;
+                                  return Stack(
+                                    clipBehavior: Clip.none,
+                                    children: <Widget>[
+                                      // 3a. 按压才出现的折射镜片：press=0 时
+                                      //     高度/位移都是 0，LiquidGlass 的守卫
+                                      //     （height<=0 || amount<=0 → 直接返回）
+                                      //     让这块彻底空掉，不耗性能。
+                                      Positioned(
+                                        left: -pad,
+                                        top: -pad,
+                                        right: -pad,
+                                        bottom: -pad,
+                                        child: IgnorePointer(
+                                          child: HalcyonLens(
+                                            shapeSize: Size(
+                                              pc.maxWidth,
+                                              pc.maxHeight,
+                                            ),
+                                            cornerRadii: Radius.circular(
+                                              radius - 4,
+                                            ),
+                                            refractionHeight: 10.0 * press,
+                                            refractionAmount: 14.0 * press,
+                                            depthEffect: true,
+                                            chromaticAberration: 0.5,
+                                          ),
+                                        ),
+                                      ),
+                                      // 3b. 面板色：0.1 黑（亮）/ 0.1 白（暗），随按压淡出。
+                                      Positioned.fill(
+                                        child: IgnorePointer(
+                                          child: ColoredBox(
+                                            color:
+                                                (isDark
+                                                        ? Colors.white
+                                                        : Colors.black)
+                                                    .withValues(
+                                                      alpha: 0.10 * (1 - press),
+                                                    ),
+                                          ),
+                                        ),
+                                      ),
+                                      // 3c. 按压增稠：0.03 黑（onDrawSurface 第二句）。
+                                      if (press > 0)
+                                        Positioned.fill(
+                                          child: IgnorePointer(
+                                            child: ColoredBox(
+                                              color: Colors.black.withValues(
+                                                alpha: 0.03 * press,
+                                              ),
+                                            ),
+                                          ),
+                                        ),
+                                    ],
+                                  );
+                                },
+                              ),
+                            ),
+                          ),
+                        ),
+                        // 5. 内容行：图标/文字浮于玻璃面上。
+                        Row(
+                          children: <Widget>[
+                            for (int i = 0; i < widget.tabCount; i++)
+                              Expanded(
+                                child: GestureDetector(
+                                  behavior: HitTestBehavior.opaque,
+                                  onTap: () => _tapItem(i),
+                                  child: Center(
+                                    child: widget.itemBuilder(
+                                      context,
+                                      i,
+                                      i == widget.selectedIndex,
+                                    ),
+                                  ),
+                                ),
+                              ),
+                          ],
+                        ),
+                    ],
+                  ),
+                ),
+              ),
+            ),
+          ),
+        );
+      },
+    );
+  }
+}
+
+/// 供 responsive_layout 组装 tab 内容的默认排版（FloatingBottomBarItem：
+/// Icon 26dp + label 11sp、垂直 1dp、选中 primary/未选中 onSurface）。
+class HalcyonDockTabContent extends StatelessWidget {
+  const HalcyonDockTabContent({
+    super.key,
+    required this.icon,
+    this.label,
+    required this.selected,
+    required this.contentColor,
+    required this.activeColor,
+  });
+
+  final Widget icon;
+  final String? label;
+  final bool selected;
+  final Color contentColor;
+  final Color activeColor;
+
+  @override
+  Widget build(BuildContext context) {
+    final Color color = selected ? activeColor : contentColor;
+    return IconTheme.merge(
+      data: IconThemeData(color: color, size: 26),
+      child: DefaultTextStyle.merge(
+        style: TextStyle(
+          fontSize: 11,
+          height: 1.0,
+          color: color,
+          fontWeight: selected ? FontWeight.w600 : FontWeight.w400,
+        ),
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          mainAxisAlignment: MainAxisAlignment.center,
+          children: <Widget>[
+            icon,
+            if (label != null && label!.isNotEmpty) ...<Widget>[
+              const SizedBox(height: 1),
+              Text(label!, maxLines: 1, overflow: TextOverflow.ellipsis),
+            ],
+          ],
+        ),
+      ),
+    );
+  }
+}
